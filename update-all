#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# update-all
#
# One place to see — and then choose to apply — pending updates across every
# package manager on this box: APT, Flatpak (user + system), global npm
# packages, hand-installed .debs that apt structurally cannot see, and
# standalone tools that live outside every manager (claude / codex / grok).
#
# An optional essentials file names the software you want called out on its
# own, pulled up out of whichever source it came from — see ESSENTIALS below.
#
# USAGE
#   update-all                  # check everything, show how to apply, then prompt
#   update-all npm deb          # only these sources (still prompts)
#   update-all --notify         # check + desktop notification (names what is pending)
#   update-all --full           # don't truncate long package lists
#   update-all --only-new       # with --notify: notify only if the pending set changed
#   update-all --no-action      # with --notify: don't arm the click-to-run action
#
#   Sources: apt  flatpak  npm  deb  standalone   (default: all)
#
# The check is READ-ONLY and needs no privileges. Applying only ever happens
# after an explicit answer at the prompt — and the prompt appears only on a
# terminal, so an unattended run (the timer) reports and stops.
#
# EXIT CODES
#   0  nothing pending, or everything applied
#   10 updates are available and were not applied
#   1  an apply failed
#
# NOTES
#   * APT reads the package lists as-is; `apt-daily.timer` refreshes them ~daily.
#     Applying runs `sudo apt-get update` first, so an apply is never stale.
#   * npm targets are ENGINE-AWARE: the newest version whose engines.node your
#     node actually satisfies, not blindly @latest (node 20 cannot run npm 12).
#   * The --notify notification is CLICKABLE: clicking its body runs update-all
#     in a terminal, where the usual prompt then decides what gets applied.
#     Dismissing it with the X applies nothing. See send_notification().
#   * The notification collapses families that share a '-'-delimited prefix
#     ("cosmic-panel", "cosmic-comp", ... -> "cosmic-* x7") so one big family
#     cannot push every other name past the "+N more" cut. See group_names().
#
# INSTALL AS A DAILY CHECK (user systemd timer — no root needed):
#   see update-all.timer / update-all.service in ~/.config/systemd/user/
#   systemctl --user enable --now update-all.timer
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

NOTIFY=false
FULL=false
ONLY_NEW=false
SOURCES=()
MAXLIST=10
NOTIFY_MAXNAMES=5   # names listed per source in the desktop notification
NOTIFY_GROUP_MIN=2  # collapse this many names sharing a '-' prefix into "prefix-* xN" (0/1 = off)
NOTIFY_ACTION=true  # arm the click-to-run action on the notification
NOTIFY_ACTION_TTL=23h        # how long the process listening for that click stays alive
NOTIFY_UNIT=update-all-notify   # transient user unit it lives in
# Terminal the click action opens. It must take the command to run as trailing
# arguments; the value is word-split on purpose so flags can be included.
UPDATE_ALL_TERMINAL="${UPDATE_ALL_TERMINAL:-cosmic-term --}"
ALL_SOURCES=(apt flatpak npm deb standalone)
# ESSENTIALS: one name per line, '#' comments, blank lines ignored. Globs work
# ('linux-*'), matching is case-insensitive, and 'source:name' restricts an
# entry to one source ('apt:code'). Names are the ones this script prints.
ESSENTIALS_FILE="${UPDATE_ALL_ESSENTIALS:-${XDG_CONFIG_HOME:-$HOME/.config}/update-all/essentials}"
ESSENTIAL_PATTERNS=()
NET_TIMEOUT=90
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/update-all"
# $0 is usually the ~/.local/bin symlink — resolve it so sibling scripts in the
# repo (update-discord) are found no matter how update-all was invoked.
SELF_DIR="$(dirname "$(readlink -f "$0")")"

for arg in "$@"; do
  case "$arg" in
    --notify)          NOTIFY=true ;;
    --full)            FULL=true ;;
    --only-new)        ONLY_NEW=true ;;
    --no-action)       NOTIFY_ACTION=false ;;
    # print the header comment block, stopping at the first line of code — a
    # fixed line range silently starts leaking `set -uo pipefail` the moment
    # anything above it grows. The rule lines are matched as "# <punctuation
    # only>" rather than /^# ─+$/: awk here is mawk, which counts BYTES, so the
    # + would bind to the last byte of the 3-byte ─ and never match.
    -h|--help)         awk 'NR==1{next} /^#/{ if ($0 ~ /^# [^a-zA-Z0-9]+$/) next; sub(/^# ?/,""); print; next } {exit}' "$0"; exit 0 ;;
    apt|flatpak|npm|deb|standalone) SOURCES+=("$arg") ;;
    *) echo "update-all: unknown argument '$arg' (try --help)" >&2; exit 1 ;;
  esac
done
(( ${#SOURCES[@]} )) || SOURCES=("${ALL_SOURCES[@]}")

wants() { local s; for s in "${SOURCES[@]}"; do [[ "$s" == "$1" ]] && return 0; done; return 1; }

# ── output helpers (same house style as list-installed) ──────────────────────
section() { printf "\n\033[1m━━━ %s ━━━\033[0m\n\n" "$1"; }
note()    { printf "  \033[2m%s\033[0m\n" "$1"; }
ok()      { printf "  \033[32m✓\033[0m %s\n" "$1"; }
warn()    { printf "  \033[33m!\033[0m %s\n" "$1"; }
join_list() { local sep="$1"; shift; local out="" i; for i in "$@"; do out+="${out:+$sep}$i"; done; printf '%s' "$out"; }

declare -A COUNT=()      # source → number pending
declare -A PENDING=()    # source → "name  old → new" lines (computed once, reused by apply)
declare -A HOWTO=()      # source → the command to apply that source by hand
TOTAL=0
FAILED=false

truncate_list() {
  local n=0 line extra=0
  while IFS= read -r line; do
    if $FULL || (( n < MAXLIST )); then printf '    %s\n' "$line"; else extra=$(( extra + 1 )); fi
    n=$(( n + 1 ))
  done
  (( extra > 0 )) && note "    … +$extra more (run with --full)"
  return 0
}

report() {  # report <source> <label> — print the cached pending list and count it
  local src="$1" label="$2" list count
  list="${PENDING[$src]:-}"
  count=$(printf '%s' "$list" | grep -c . )
  COUNT[$src]=$count
  if (( count == 0 )); then ok "up to date"; else
    printf "  %s %s\n" "$count" "$label"
    printf '%s\n' "$list" | truncate_list
    TOTAL=$(( TOTAL + count ))
  fi
}

newer() {
  [[ "$1" == "$2" ]] && return 1
  [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$2" ]]
}

load_essentials() {
  [[ -r "$ESSENTIALS_FILE" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"                                # strip comments
    line="${line#"${line%%[![:space:]]*}"}"           # ltrim
    line="${line%"${line##*[![:space:]]}"}"           # rtrim
    [[ -n "$line" ]] && ESSENTIAL_PATTERNS+=("$line")
  done < "$ESSENTIALS_FILE"
}

is_essential() {  # is_essential <source> <name>
  (( ${#ESSENTIAL_PATTERNS[@]} )) || return 1
  local src="$1" name="$2" pat psrc rc=1
  shopt -s nocasematch
  for pat in "${ESSENTIAL_PATTERNS[@]}"; do
    psrc=""
    [[ "$pat" == *:* ]] && { psrc="${pat%%:*}"; pat="${pat#*:}"; }
    [[ -n "$psrc" && "$src" != "$psrc" ]] && continue
    # unquoted RHS on purpose: the pattern is a glob, so 'linux-*' works
    if [[ "$name" == $pat ]]; then rc=0; break; fi
  done
  shopt -u nocasematch
  return $rc
}

src_names() {  # src_names <source> <essential|rest> → one name per line
  local src="$1" want="$2" line name
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    name="${line%%  *}"
    if is_essential "$src" "$name"; then
      [[ "$want" == essential ]] && printf '%s\n' "$name"
    else
      [[ "$want" == rest ]] && printf '%s\n' "$name"
    fi
  done <<<"${PENDING[$src]:-}"
  return 0
}

group_names() {  # stdin: one name per line → one "<count><TAB><display>" line per entry
  # Names sharing their first '-'-delimited token collapse into a single entry
  # (cosmic-panel, cosmic-comp, … → "cosmic-* ×7"), so one big family costs ONE
  # of the NOTIFY_MAXNAMES slots instead of burying every other name behind
  # "+N more" — on a 149-package apt day that is the difference between seeing
  # brave-browser and not. Order follows each group's first member. Names with
  # no '-' (flatpak display names, most standalone tools) are never touched.
  local -a names=(); local -A cnt=() seen=(); local n key
  mapfile -t names
  (( ${#names[@]} )) || return 0
  if (( NOTIFY_GROUP_MIN < 2 )); then printf '1\t%s\n' "${names[@]}"; return 0; fi
  for n in "${names[@]}"; do
    [[ "$n" == *-* ]] || continue
    key="${n%%-*}"; cnt["$key"]=$(( ${cnt["$key"]:-0} + 1 ))
  done
  for n in "${names[@]}"; do
    key="${n%%-*}"
    if [[ "$n" == *-* ]] && (( ${cnt["$key"]:-0} >= NOTIFY_GROUP_MIN )); then
      [[ -n "${seen["$key"]:-}" ]] && continue
      seen["$key"]=1
      printf '%d\t%s-* ×%d\n' "${cnt["$key"]}" "$key" "${cnt["$key"]}"
    else
      printf '1\t%s\n' "$n"
    fi
  done
}

notify_lines() {  # one line per pending source, naming what will change
  # Every source formats its pending list as "name<2 spaces>old → new", so the
  # name is whatever precedes the first double space — this also survives
  # flatpak's spaced display names ("Ente Photos").
  local src n names shown extra e entries pkgs_shown ess=()
  # Essentials go first AND are removed from their own source's line below, so
  # a name never appears twice and can never be pushed out of sight by the cap.
  # Deliberately uncapped, and deliberately NOT prefix-grouped: the list is
  # curated by hand, so its length is yours to control, and collapsing or
  # truncating the one list you asked to see by name defeats the point.
  for src in "${PENDING_SOURCES[@]}"; do
    mapfile -t -O "${#ess[@]}" ess < <(src_names "$src" essential)
  done
  (( ${#ess[@]} )) && printf 'essentials %d — %s\n' "${#ess[@]}" "$(join_list ', ' "${ess[@]}")"
  for src in "${PENDING_SOURCES[@]}"; do
    n=${COUNT[$src]:-0}
    mapfile -t names < <(src_names "$src" rest)
    if (( ${#names[@]} == 0 )); then
      # a source can report a count with no names (flatpak: runtimes only);
      # if it had names and they were all essential, it has nothing left to say
      [[ -z "${PENDING[$src]:-}" ]] && (( n > 0 )) && printf '%s: %d\n' "$src" "$n"
      continue
    fi
    mapfile -t entries < <(printf '%s\n' "${names[@]}" | group_names)
    shown=(); pkgs_shown=0
    for e in "${entries[@]:0:NOTIFY_MAXNAMES}"; do
      shown+=( "${e#*$'\t'}" )
      pkgs_shown=$(( pkgs_shown + ${e%%$'\t'*} ))
    done
    # "+N more" keeps counting PACKAGES, not entries — a collapsed group already
    # carries its own ×N, so counting entries would hide those twice over.
    extra=$(( ${#names[@]} - pkgs_shown ))
    printf '%s %d — %s' "$src" "${#names[@]}" "$(join_list ', ' "${shown[@]}")"
    (( extra > 0 )) && printf ', +%d more' "$extra"
    printf '\n'
  done
}

action_available() {  # can the notification be made clickable?
  $NOTIFY_ACTION || return 1
  command -v systemd-run >/dev/null 2>&1 || return 1
  command -v "${UPDATE_ALL_TERMINAL%% *}" >/dev/null 2>&1 || return 1
  return 0
}

notify_plain() {  # fire-and-forget: no action, nothing left running
  # -t 0: never expire. This is a once-a-day reminder — a banner that vanishes after a
  # few seconds is missed unless you happen to be looking at the screen when the timer fires.
  # (Keep comments ABOVE this chain: one inserted between the last `\` and the
  #  command still passes `bash -n` but silently detaches the env prefix.)
  DISPLAY="$1" DBUS_SESSION_BUS_ADDRESS="$2" \
  notify-send -a "update-all" -i software-update-available -t 0 "$3" "$4" || true
}

send_notification() {
  local summary="$1" body="$2" disp bus
  command -v notify-send >/dev/null 2>&1 || return 0
  disp="${DISPLAY:-:0}"
  bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

  if ! action_available; then notify_plain "$disp" "$bus" "$summary" "$body"; return 0; fi

  # cosmic-notifications draws NO action buttons — it advertises `actions` in
  # GetCapabilities and then ignores the labels — but it DOES deliver
  # ActionInvoked when the notification body is clicked, firing the first action.
  # So a single action named `default` means "click the notification to run this",
  # while the X still dismisses without firing anything. (Probed 2026-09-05.)
  #
  # Two measured facts force the shape below:
  #   * `notify-send -A` implies --wait, and this daemon never emits
  #     NotificationClosed — not on dismiss, not even on expiry — so the waiting
  #     process would hang forever. It has to be time-bounded from outside.
  #   * When ExecStart returns, systemd kills the rest of the service cgroup, so
  #     a plain background child would die with the check. It needs its own unit.
  # …and a third fact shapes the click handler: cosmic-term DOUBLE-FORKS and
  # returns in ~5 ms, so a terminal started inside this unit is killed by the
  # cgroup teardown the instant the waiter exits — it never draws. It therefore
  # goes into a unit of its own with KillMode=process. That property must NOT be
  # put on the waiter: stopping a waiter would then leave its notify-send behind,
  # blocked forever on a NotificationClosed this daemon never sends.
  systemctl --user stop         "$NOTIFY_UNIT.service" >/dev/null 2>&1
  systemctl --user reset-failed "$NOTIFY_UNIT.service" >/dev/null 2>&1
  # $4 (the terminal) is unquoted on purpose — it carries its own arguments.
  if systemd-run --user --quiet --collect --unit="$NOTIFY_UNIT" \
       --property=RuntimeMaxSec="$NOTIFY_ACTION_TTL" \
       --setenv=DISPLAY="$disp" --setenv=DBUS_SESSION_BUS_ADDRESS="$bus" \
       bash -c '
         a=$(notify-send -a "update-all" -i software-update-available -t 0 \
               -A "default=$3" "$1" "$2") || exit 0
         [ "$a" = default ] || exit 0
         exec systemd-run --user --quiet --collect --property=KillMode=process \
              --description="update-all (from notification)" \
              $4 bash -lc "$5"
       ' "$NOTIFY_UNIT" "$summary" "$body" "Update now" "$UPDATE_ALL_TERMINAL" \
         'update-all; printf "\n[finished — press enter to close] "; read -r _'
  then return 0; fi
  # transient unit refused (no user manager, name taken, …) — still notify
  notify_plain "$disp" "$bus" "$summary" "$body"
}

find_npm() {
  # Prefer the nvm-managed npm — that's where the global packages live. A distro
  # npm (/usr/bin/npm, 9.2.0) sits on the default PATH and would report an empty
  # /usr/local prefix, which is exactly what a systemd timer would otherwise pick.
  local nvm_root="${NVM_DIR:-$HOME/.nvm}" want n
  want=$(cat "$nvm_root/alias/default" 2>/dev/null)
  if [[ -n "$want" ]]; then
    n=$(ls -d "$nvm_root"/versions/node/v"${want#v}"*/bin/npm 2>/dev/null | sort -V | tail -n1)
    [[ -x "$n" ]] && { echo "$n"; return 0; }
  fi
  n=$(ls -d "$nvm_root"/versions/node/*/bin/npm 2>/dev/null | sort -V | tail -n1)
  [[ -x "$n" ]] && { echo "$n"; return 0; }
  command -v npm 2>/dev/null
}
NPM="$(find_npm || true)"
# npm is a JS shim with `#!/usr/bin/env node`, so it runs on whatever node PATH
# resolves first. Without this, the nvm npm executes under the distro node and
# reports that node's global prefix (/usr) with none of the real packages.
[[ -n "$NPM" ]] && PATH="$(dirname "$NPM"):$PATH"
NODE="${NPM%/npm}/node"; [[ -x "$NODE" ]] || NODE="$(command -v node 2>/dev/null)"

find_bin() {
  command -v "$1" 2>/dev/null && return 0
  local p
  for p in "$HOME/.local/bin/$1" "$HOME/.grok/bin/$1"; do [[ -x "$p" ]] && { echo "$p"; return 0; }; done
  return 1
}

# ── APT ──────────────────────────────────────────────────────────────────────
check_apt() {
  section "APT"
  HOWTO[apt]='sudo apt update && sudo apt full-upgrade'
  local stamp age
  stamp=$(stat -c %Y /var/lib/apt/lists 2>/dev/null || echo 0)
  age=$(( ( $(date +%s) - stamp ) / 3600 ))
  PENDING[apt]=$(apt list --upgradable 2>/dev/null | tail -n +2 \
         | sed -E 's|^([^/]+)/\S+ (\S+) \S+ \[upgradable from: ([^]]+)\]|\1  \3 → \2|')
  report apt "package(s) upgradable"
  note "package lists last refreshed ${age}h ago (apt-daily.timer)"
}

apply_apt() {
  section "APT — applying"
  if sudo apt-get update -q && sudo apt-get full-upgrade -y; then
    ok "apt done"
    note "run 'sudo apt autoremove' separately if you want orphans purged"
  else
    warn "apt failed"; FAILED=true
  fi
}

# ── Flatpak ──────────────────────────────────────────────────────────────────
check_flatpak() {
  section "Flatpak"
  HOWTO[flatpak]='flatpak update'
  local scope out="" rt
  for scope in user system; do
    out+=$(timeout "$NET_TIMEOUT" flatpak remote-ls --updates --app --"$scope" \
             --columns=name,application,version 2>/dev/null \
           | sed -E "s/\t/  /g; s/$/  [$scope]/")$'\n'
  done
  rt=$(timeout "$NET_TIMEOUT" flatpak remote-ls --updates --runtime 2>/dev/null | grep -c . )
  PENDING[flatpak]=$(printf '%s' "$out" | grep . )
  report flatpak "app(s)"
  if (( rt > 0 )); then
    note "plus $rt runtime/extension update(s) — pulled in by the same command"
    (( ${COUNT[flatpak]:-0} == 0 )) && { COUNT[flatpak]=$rt; TOTAL=$(( TOTAL + rt )); }
  fi
}

apply_flatpak() {
  section "Flatpak — applying"
  local bad=false
  flatpak update -y --user   || { warn "flatpak --user failed"; bad=true; }
  flatpak update -y --system || { warn "flatpak --system failed (polkit auth?)"; bad=true; }
  $bad && FAILED=true || ok "flatpak done"
  note "unused runtimes can be reclaimed with: flatpak uninstall --unused"
}

# ── npm globals ──────────────────────────────────────────────────────────────
# ENGINE-AWARE. `npm outdated` reports the registry's `latest` dist-tag with no
# regard for whether the running node can execute it: on node 20 that offered
# npm@12 (requires node >=22), which npm then refuses with EBADENGINE, and
# corepack@0.35.0, which installs with only a warning and is then unsupported.
# So resolve, per package, the newest published version whose engines.node this
# node actually satisfies — using the semver that npm itself ships.
npm_best_version() {  # <pkg> <current> → "target<TAB>reason"
  local pkg="$1" cur="$2" semver_dir url
  semver_dir="$("$NPM" root -g 2>/dev/null)/npm/node_modules/semver"
  [[ -d "$semver_dir" && -x "$NODE" ]] || return 1
  url="https://registry.npmjs.org/${pkg//\//%2f}"
  timeout "$NET_TIMEOUT" curl -fsSL "$url" 2>/dev/null | "$NODE" -e '
    const semver = require(process.argv[1]);
    const cur = process.argv[2];
    let raw = ""; process.stdin.on("data", d => raw += d).on("end", () => {
      let p; try { p = JSON.parse(raw) } catch (e) { process.exit(1) }
      const versions = p.versions || {};
      const latest = (p["dist-tags"] || {}).latest || null;
      const fits = v => {
        const eng = ((versions[v] || {}).engines || {}).node;
        return !eng || semver.satisfies(process.versions.node, eng);
      };
      // Prefer the latest dist-tag — that is the channel the publisher points at.
      if (latest && fits(latest) && semver.gt(latest, cur)) return console.log(latest + "\t");
      // Otherwise take the newest version this node can actually run. Two cases
      // land here: latest needs a newer node, or the installed version is already
      // past the latest tag (an off-tag/preview line the user opted into).
      let best = null;
      for (const [v, m] of Object.entries(versions)) {
        if (semver.prerelease(v) || m.deprecated || !fits(v)) continue;
        if (!best || semver.gt(v, best)) best = v;
      }
      if (!best) return console.log("\t");
      let reason = "";
      if (latest && !fits(latest)) {
        const eng = (versions[latest].engines || {}).node || "?";
        reason = `latest ${latest} needs node ${eng}`;
      } else if (latest && semver.gt(best, latest)) {
        reason = `ahead of the ${latest} latest tag — staying on that line`;
      }
      console.log(best + "\t" + reason);
    })' "$semver_dir" "$cur"
}

npm_pending() {
  [[ -n "$NPM" && -x "$NODE" ]] || return 0
  local json
  json=$(timeout "$NET_TIMEOUT" "$NPM" outdated -g --depth=0 --json 2>/dev/null)
  [[ -z "$json" || "$json" == "{}" ]] && return 0
  printf '%s' "$json" | "$NODE" -e '
    let raw=""; process.stdin.on("data",d=>raw+=d).on("end",()=>{
      let o={}; try { o=JSON.parse(raw) } catch(e) { process.exit(0) }
      for (const [name,v] of Object.entries(o))
        if (v.current) console.log(`${name}\t${v.current}`)
    })' | while IFS=$'\t' read -r name cur; do
      local target reason
      IFS=$'\t' read -r target reason < <(npm_best_version "$name" "$cur")
      [[ -z "$target" ]] && continue
      newer "$cur" "$target" || continue
      if [[ -n "$reason" ]]; then
        printf '%s  %s → %s   (%s)\n' "$name" "$cur" "$target" "$reason"
      else
        printf '%s  %s → %s\n' "$name" "$cur" "$target"
      fi
    done
}

# Globals whose INSTALLED version declares an engines.node this node doesn't
# satisfy — they are not "outdated" (a compatible version is older), so nothing
# else would ever report them. corepack@0.35.0 landed here on node 20.
npm_unsupported() {
  [[ -n "$NPM" && -x "$NODE" ]] || return 0
  local root; root="$("$NPM" root -g 2>/dev/null)"
  local semver_dir="$root/npm/node_modules/semver"
  [[ -d "$root" && -d "$semver_dir" ]] || return 0
  "$NODE" -e '
    const fs = require("fs"), path = require("path");
    const semver = require(process.argv[2]);
    const root = process.argv[1];
    const dirs = [];
    for (const e of fs.readdirSync(root, {withFileTypes:true})) {
      if (!e.isDirectory()) continue;
      if (e.name.startsWith("@")) {
        for (const s of fs.readdirSync(path.join(root, e.name))) dirs.push(path.join(e.name, s));
      } else dirs.push(e.name);
    }
    for (const d of dirs) {
      let pkg; try { pkg = JSON.parse(fs.readFileSync(path.join(root, d, "package.json"), "utf8")) } catch (e) { continue }
      const eng = (pkg.engines || {}).node;
      if (eng && !semver.satisfies(process.versions.node, eng))
        console.log(`${pkg.name}@${pkg.version} needs node ${eng}`);
    }' "$root" "$semver_dir" 2>/dev/null
}

check_npm() {
  section "npm (global)"
  if [[ -z "$NPM" ]]; then warn "npm not found"; COUNT[npm]=0; return 0; fi
  PENDING[npm]=$(npm_pending)
  report npm "global package(s)"
  local cmds=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    cmds+="${cmds:+ && }npm -g install $(awk '{print $1"@"$4}' <<<"$line")"
  done <<<"${PENDING[npm]}"
  HOWTO[npm]="${cmds:-npm -g outdated}"
  note "prefix: $("$NPM" config get prefix 2>/dev/null) · node $("$NODE" -v 2>/dev/null) · ignore-scripts=$("$NPM" config get ignore-scripts 2>/dev/null)"
  local unsup; unsup=$(npm_unsupported)
  if [[ -n "$unsup" ]]; then
    while IFS= read -r line; do warn "unsupported: $line (yours: $("$NODE" -v))"; done <<<"$unsup"
    note "not an update — a newer node fixes it, or pin back to the last compatible release"
  fi
}

apply_npm() {
  section "npm (global) — applying"
  [[ -n "$NPM" ]] || { warn "npm not found"; return 0; }
  local line pkg ver bad=false
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    pkg=$(awk '{print $1}' <<<"$line"); ver=$(awk '{print $4}' <<<"$line")
    echo "  → $pkg@$ver"
    "$NPM" install -g "$pkg@$ver" >/dev/null || { warn "$pkg failed"; bad=true; }
  done <<<"${PENDING[npm]}"
  $bad && FAILED=true || ok "npm done  (install scripts stayed disabled — global policy)"
}

# ── Hand-installed .debs ─────────────────────────────────────────────────────
# Packages installed from a downloaded .deb with no apt repo behind them: dpkg
# knows the version, apt has no candidate newer than what's installed, so they
# are invisible to `apt list --upgradable` forever. Each needs its own upstream
# version oracle. Spot new members of this class with:
#   comm -23 <(dpkg-query -W -f='${Package}\n' | sort) \
#            <(apt-cache dumpavail | awk '/^Package: /{print $2}' | sort -u)
PROTON_FEED="https://proton.me/download/mail/linux/version.json"
PROTON_CONFIG="$HOME/.config/Proton Mail/config.json"

find_update_discord() {
  local c
  for c in "$SELF_DIR/update-discord" "$HOME/.local/bin/update-discord" "$(command -v update-discord 2>/dev/null)"; do
    [[ -n "$c" && -x "$c" ]] && { echo "$c"; return 0; }
  done
  return 1
}

# Which releases THIS install is entitled to, read from the app's own config
# rather than assumed. The feed carries three interleaved channels and the app
# picks by `settings.releaseCategory`; a box switched to EarlyAccess is offered
# builds a Stable-only check can never see, and then nags in-app about an update
# this script keeps reporting as absent (1.13.4 vs 1.14.0, seen 2026-09-05).
# Each channel also accepts everything more conservative than itself, the way
# the app does. Config missing or unreadable → assume Stable, the old behaviour.
proton_channels() {
  local cat=Stable
  [[ -r "$PROTON_CONFIG" ]] && command -v jq >/dev/null 2>&1 \
    && cat=$(jq -r '.settings.releaseCategory // "Stable"' "$PROTON_CONFIG" 2>/dev/null)
  case "$cat" in
    Alpha)       echo 'Stable EarlyAccess Alpha' ;;
    EarlyAccess) echo 'Stable EarlyAccess' ;;
    *)           echo 'Stable' ;;
  esac
}

# This install's fixed slot in a staged rollout (`appID.distribution`, 0–1). The
# app offers a release only once its RolloutProportion has reached that slot, so
# honouring it keeps this report in step with what the app will actually do
# instead of nagging daily about a build still being staged. Unknown → 0, which
# gates nothing: better to report early than to hide an update.
proton_distribution() {
  local d=''
  [[ -r "$PROTON_CONFIG" ]] && command -v jq >/dev/null 2>&1 \
    && d=$(jq -r '.appID.distribution // empty' "$PROTON_CONFIG" 2>/dev/null)
  [[ "$d" =~ ^(0|1)(\.[0-9]+)?$ ]] || d=0
  echo "$d"
}

proton_feed() {  # → version <tab> url <tab> sha512   (newest release this install is offered)
  command -v jq >/dev/null 2>&1 || return 1
  local cats dist ver url sha best_v='' best_line=''
  cats=$(proton_channels); dist=$(proton_distribution)
  # The feed is not sorted by version, and the channels interleave — so collect
  # every eligible release and pick the highest with dpkg's own comparison.
  while IFS=$'\t' read -r ver url sha; do
    [[ -n "$ver" && -n "$url" ]] || continue
    if [[ -z "$best_v" ]] || dpkg --compare-versions "$best_v" lt "$ver"; then
      best_v="$ver"; best_line=$(printf '%s\t%s\t%s' "$ver" "$url" "$sha")
    fi
  done < <(timeout "$NET_TIMEOUT" curl -fsSL "$PROTON_FEED" 2>/dev/null \
    | jq -r --arg cats "$cats" --argjson dist "$dist" '
        .Releases[]
        | select(.CategoryName as $c | ($cats | split(" ")) | index($c))
        | select((.RolloutProportion // 1) >= $dist)
        | [.Version, (.File[] | select(.Identifier | test("deb")) | .Url, .Sha512CheckSum)]
        | @tsv' 2>/dev/null)
  [[ -n "$best_line" ]] && printf '%s\n' "$best_line"
}

deb_pending() {
  local have want ud chan
  if ud=$(find_update_discord); then
    timeout "$NET_TIMEOUT" "$ud" --check --no-notify 2>/dev/null \
      | sed -nE 's/^Update available: (\S+) -> (\S+)$/discord  \1 → \2/p'
  fi
  if have=$(dpkg-query -W -f='${Version}' proton-mail 2>/dev/null); then
    want=$(proton_feed | cut -f1)
    chan=$(proton_channels); chan="${chan##* }"   # the widest channel in play
    [[ -n "$want" ]] && dpkg --compare-versions "$have" lt "$want" \
      && printf 'proton-mail  %s → %s%s\n' "$have" "$want" \
         "$([[ "$chan" == Stable ]] || echo " ($chan channel)")"
  fi
}

check_deb() {
  section "Hand-installed .debs"
  PENDING[deb]=$(deb_pending)
  report deb "package(s)"
  local hints=()
  grep -q '^discord' <<<"${PENDING[deb]}" && hints+=("update-discord")
  grep -q '^proton-mail' <<<"${PENDING[deb]}" && hints+=("update-all deb")
  HOWTO[deb]=$(join_list '  ·  ' "${hints[@]:-}")
  note "no apt repo behind these — apt will never offer them"
}

apply_deb() {
  section "Hand-installed .debs — applying"
  local line name tmp url sha bad=false
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name=${line%% *}
    case "$name" in
      discord)
        echo "  → discord"
        "$(find_update_discord)" || { warn "discord failed"; bad=true; }
        ;;
      proton-mail)
        echo "  → proton-mail"
        IFS=$'\t' read -r _ url sha < <(proton_feed)
        if [[ -z "$url" ]]; then warn "no download URL in the Proton feed"; bad=true; continue; fi
        tmp=$(mktemp -d)
        if timeout 600 curl -fL# "$url" -o "$tmp/proton-mail.deb"; then
          # The checksum ships in the same TLS-protected feed as the URL, so this
          # guards against a truncated/corrupt download, not against a bad feed.
          if [[ -n "$sha" ]] && ! echo "$sha  $tmp/proton-mail.deb" | sha512sum -c --status; then
            warn "proton-mail: SHA512 mismatch — refusing to install"; bad=true
          else
            sudo dpkg -i "$tmp/proton-mail.deb" || { warn "proton-mail install failed"; bad=true; }
          fi
        else
          warn "proton-mail download failed"; bad=true
        fi
        rm -rf "$tmp"
        ;;
    esac
  done <<<"${PENDING[deb]}"
  $bad && FAILED=true || ok "hand-installed .debs done"
}

# ── Standalone (installed outside every package manager) ────────────────────
standalone_pending() {
  local bin have want
  if bin=$(find_bin claude); then
    have=$("$bin" --version 2>/dev/null | grep -oE '^[0-9.]+')
    want=$(timeout "$NET_TIMEOUT" "${NPM:-npm}" view @anthropic-ai/claude-code version 2>/dev/null | tr -d '[:space:]')
    [[ -n "$have" && -n "$want" ]] && newer "$have" "$want" && printf 'claude  %s → %s\n' "$have" "$want"
  fi
  if bin=$(find_bin codex); then
    have=$("$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
    want=$(timeout "$NET_TIMEOUT" "${NPM:-npm}" view @openai/codex version 2>/dev/null | tr -d '[:space:]')
    [[ -n "$have" && -n "$want" ]] && newer "$have" "$want" && printf 'codex  %s → %s\n' "$have" "$want"
  fi
  if bin=$(find_bin grok); then
    local json
    json=$(timeout "$NET_TIMEOUT" "$bin" update --check --json 2>/dev/null)
    if [[ "$json" == *'"updateAvailable":true'* ]]; then
      have=$(sed -nE 's/.*"currentVersion":"([^"]+)".*/\1/p' <<<"$json")
      want=$(sed -nE 's/.*"latestVersion":"([^"]+)".*/\1/p' <<<"$json")
      printf 'grok  %s → %s\n' "$have" "$want"
    fi
  fi
}

check_standalone() {
  section "Standalone"
  PENDING[standalone]=$(standalone_pending)
  report standalone "tool(s)"
  local hints=()
  grep -q '^claude' <<<"${PENDING[standalone]}" && hints+=("claude update")
  grep -q '^grok'   <<<"${PENDING[standalone]}" && hints+=("grok update")
  grep -q '^codex'  <<<"${PENDING[standalone]}" && hints+=("update-all standalone")
  HOWTO[standalone]=$(join_list '  ·  ' "${hints[@]:-}")
  grep -q '^codex' <<<"${PENDING[standalone]}" && \
    note "codex is a release binary — 'codex update' can't self-update it, update-all replaces it"
}

# codex here is the GitHub release binary (deliberate: leanest trusted channel),
# so its own `update` bails with "Could not detect the Codex installation method".
apply_codex() {
  local bin tmp url asset
  bin=$(find_bin codex) || return 1
  url=$(timeout "$NET_TIMEOUT" curl -fsSL https://api.github.com/repos/openai/codex/releases/latest 2>/dev/null \
        | jq -r '.assets[] | select(.name == "codex-x86_64-unknown-linux-musl.tar.gz") | .browser_download_url')
  [[ -z "$url" || "$url" == null ]] && { warn "codex: no linux-musl asset in the latest release"; return 1; }
  tmp=$(mktemp -d)
  timeout 900 curl -fL# "$url" -o "$tmp/codex.tar.gz" || { warn "codex download failed"; rm -rf "$tmp"; return 1; }
  tar -xzf "$tmp/codex.tar.gz" -C "$tmp" || { warn "codex: extract failed"; rm -rf "$tmp"; return 1; }
  asset=$(find "$tmp" -type f -name 'codex*' ! -name '*.tar.gz' | head -n1)
  [[ -x "$asset" ]] || chmod +x "$asset" 2>/dev/null
  # Prove the new binary runs before it replaces the working one.
  if ! "$asset" --version >/dev/null 2>&1; then warn "codex: new binary won't run — keeping the old one"; rm -rf "$tmp"; return 1; fi
  cp -f "$bin" "$bin.bak" && mv -f "$asset" "$bin" && chmod +x "$bin" || { warn "codex: replace failed"; rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  echo "    now $("$bin" --version 2>/dev/null) · previous kept at $bin.bak (~$(du -h "$bin.bak" | cut -f1), delete when happy)"
}

apply_standalone() {
  section "Standalone — applying"
  local line name bin bad=false
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name=${line%% *}
    echo "  → $name"
    if [[ "$name" == codex ]]; then
      apply_codex || { bad=true; }
    else
      bin=$(find_bin "$name") || continue
      "$bin" update || { warn "$name update failed"; bad=true; }
    fi
  done <<<"${PENDING[standalone]}"
  $bad && FAILED=true || ok "standalone done"
}

# ── run ──────────────────────────────────────────────────────────────────────
load_essentials
printf "\033[1mupdate-all\033[0m — %s\n" "$(date '+%Y-%m-%d %H:%M')"

for s in "${ALL_SOURCES[@]}"; do wants "$s" && "check_$s"; done

PENDING_SOURCES=()
SUMMARY=()
for s in "${ALL_SOURCES[@]}"; do
  (( ${COUNT[$s]:-0} > 0 )) && { PENDING_SOURCES+=("$s"); SUMMARY+=("$s: ${COUNT[$s]}"); }
done

echo
if (( TOTAL == 0 )); then
  printf "\033[1;32mEverything is up to date.\033[0m\n"
  exit 0
fi

if (( ${#ESSENTIAL_PATTERNS[@]} )); then
  ess_lines=$(for s in "${PENDING_SOURCES[@]}"; do
                while IFS= read -r line; do
                  [[ -n "$line" ]] || continue
                  is_essential "$s" "${line%%  *}" && printf '%-11s %s\n' "$s" "$line"
                done <<<"${PENDING[$s]:-}"
              done)
  if [[ -n "$ess_lines" ]]; then
    section "Essentials"
    printf '%s\n' "$ess_lines" | while IFS= read -r line; do printf '    %s\n' "$line"; done
    note "also counted under their own source below — apply them with that source's command"
  fi
fi

printf "\033[1;33m%d update(s) pending\033[0m — %s\n" "$TOTAL" "$(join_list ', ' "${SUMMARY[@]}")"

# ── how to apply each source by hand ─────────────────────────────────────────
section "Apply separately"
for s in "${PENDING_SOURCES[@]}"; do
  printf "  \033[1m%-11s\033[0m %3d  \033[2m%s\033[0m\n" "$s" "${COUNT[$s]}" "${HOWTO[$s]:-}"
done

if $NOTIFY; then
  mkdir -p "$CACHE_DIR"
  body=$(notify_lines)
  # fingerprint the named set, not just the counts — otherwise --only-new stays
  # silent when the same number of different packages comes up
  fingerprint=$(printf '%s' "$body" | md5sum | cut -d' ' -f1)
  if ! $ONLY_NEW || [[ "$fingerprint" != "$(cat "$CACHE_DIR/last" 2>/dev/null)" ]]; then
    hint="Run: update-all"
    action_available && hint="Click this notification to update  ·  or run: update-all"
    send_notification "$TOTAL update(s) available" "$body

$hint"
  fi
  printf '%s' "$fingerprint" > "$CACHE_DIR/last"
fi

# ── prompt ───────────────────────────────────────────────────────────────────
# Only on a terminal: an unattended run (timer, pipe, cron) reports and stops.
if [[ ! -t 0 || ! -t 1 ]]; then
  echo
  note "not a terminal — reporting only; run update-all from a shell to apply"
  exit 10
fi

echo
read -r -p "Apply now? [y] all · [n] none · or name sources (${PENDING_SOURCES[*]}): " answer
answer=${answer:-n}

case "$answer" in
  y|Y|yes|all) CHOSEN=("${PENDING_SOURCES[@]}") ;;
  n|N|no|"")   echo "Nothing applied."; exit 10 ;;
  *)
    CHOSEN=()
    for want in $answer; do
      for s in "${PENDING_SOURCES[@]}"; do [[ "$want" == "$s" ]] && CHOSEN+=("$s"); done
    done
    if (( ${#CHOSEN[@]} == 0 )); then
      echo "No pending source matched '$answer' — nothing applied." >&2; exit 10
    fi
    ;;
esac

for s in "${ALL_SOURCES[@]}"; do
  for c in "${CHOSEN[@]}"; do [[ "$c" == "$s" ]] && "apply_$s"; done
done

echo
$FAILED && { printf "\033[1;31mSome updates failed — see above.\033[0m\n"; exit 1; }
printf "\033[1;32mApplied: %s\033[0m\n" "$(join_list ', ' "${CHOSEN[@]}")"
exit 0
