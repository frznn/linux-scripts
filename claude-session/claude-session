#!/usr/bin/env bash
# claude-session — manage Claude Code session transcripts.
#
# Sessions are stored as  ~/.claude/projects/<encoded-cwd>/<uuid>.jsonl
# (plus an optional <uuid>/ sidecar dir). Deletion intent is recorded as a
# marker file "<uuid>.jsonl.delete" next to the transcript — the SAME primitive
# the dev-workspace SessionEnd cleanup uses. A marked transcript is removed when
# its session next ends (SessionEnd hook) or, if the session isn't live, on the
# next Claude Code launch (SessionStart reap) — never while it is still live.
#
# An <id> is a full session UUID or any unambiguous PREFIX of one — e.g. the
# short id shown by `list` (the first block). An ambiguous prefix is rejected
# and its candidates are listed, so nothing is deleted by guess.
#
# Subcommands:
#   list [-l]            show sessions newest-first: short-id · title; [MARKED] = marked.
#                        -l / --long prints full UUIDs instead of short ids.
#   mark   [<id>]        mark a session for deletion (default: the current session)
#   unmark <id>          remove a session's deletion marker
#   marked               list sessions currently marked for deletion
#   delete [-f] <id>...  delete transcript(s) RIGHT NOW; refuses a LIVE session
#                        (one a running Claude Code owns) unless -f/--force is given
#   reap   [<current>]   delete every MARKED, non-live session (used by the SessionStart hook)
#
# Env overrides: CLAUDE_PROJECTS_DIR, CLAUDE_SESSIONS_DIR, CLAUDE_SESSION_ID.
set -euo pipefail

PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"

die() { echo "claude-session: $*" >&2; exit 1; }

# Emit the transcript file and sidecar dir belonging to a session id (if any).
paths_for() {
  local id="$1"
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 \( -name "$id.jsonl" -o -name "$id" \) 2>/dev/null || true
}

# The .jsonl transcript path for a session id ("" if none).
transcript_for() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name "$1.jsonl" 2>/dev/null | head -1
}

# Session ids that currently carry a .delete marker.
marked_ids() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl.delete' 2>/dev/null \
    | sed -e 's#.*/##' -e 's/\.jsonl\.delete$//'
}

# Latest AI-generated title for a session transcript ("" if none / no jq).
title_for() {
  command -v jq >/dev/null 2>&1 || return 0
  jq -r 'select(.type=="ai-title") | .aiTitle // empty' "$1" 2>/dev/null | tail -1
}

# All known session ids (basenames of the transcript files).
all_ids() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' -printf '%f\n' 2>/dev/null | sed 's/\.jsonl$//'
}

# Resolve <query> against candidate ids on stdin. Prints the full id and returns
# 0 on an exact or unique-prefix match; returns 1 if nothing matches; or prints
# the candidates to stderr and returns 2 if the prefix is ambiguous.
_resolve() {
  local q="$1" line; local -a hits=()
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$line" = "$q" ] && { printf '%s\n' "$line"; return 0; }
    case "$line" in "$q"*) hits+=("$line");; esac
  done
  case "${#hits[@]}" in
    1) printf '%s\n' "${hits[0]}"; return 0;;
    0) return 1;;
    *) { echo "claude-session: ambiguous id '$q' — matches:"; printf '  %s\n' "${hits[@]}"; } >&2; return 2;;
  esac
}

# Session ids that are currently LIVE. Claude Code writes one
# ~/.claude/sessions/<pid>.json per running process (with its .sessionId); we
# trust an entry only if <pid> is still a running process (skips stale/crashed
# files). Also includes this command's own session from the environment.
LIVE_REGISTRY="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
live_ids() {
  {
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo "$CLAUDE_CODE_SESSION_ID"; fi
    if [ -n "${CLAUDE_SESSION_ID:-}" ]; then echo "$CLAUDE_SESSION_ID"; fi
    if [ -d "$LIVE_REGISTRY" ]; then
      local f pid sid
      for f in "$LIVE_REGISTRY"/*.json; do
        [ -e "$f" ] || continue
        pid="$(basename "$f" .json)"
        case "$pid" in *[!0-9]*|'') continue;; esac   # only numeric <pid>.json
        [ -d "/proc/$pid" ] || continue               # skip stale (dead pid)
        if command -v jq >/dev/null 2>&1; then
          sid="$(jq -r '.sessionId // empty' "$f" 2>/dev/null)"
        else
          sid="$(sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)"
        fi
        if [ -n "$sid" ]; then echo "$sid"; fi
      done
    fi
  } | sort -u
}

cmd_list() {
  local long=0
  case "${1:-}" in -l|--long) long=1;; esac
  local marked_list; marked_list="$(marked_ids)"
  local id show sz mt flag f title
  find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | while read -r _ f; do
      id="$(basename "$f" .jsonl)"
      if [ "$long" = 1 ]; then show="$id"; else show="${id%%-*}"; fi
      sz="$(du -h "$f" 2>/dev/null | cut -f1)"
      mt="$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)"
      title="$(title_for "$f")"
      flag=""
      if printf '%s\n' "$marked_list" | grep -qxF "$id"; then flag="  [MARKED]"; fi
      printf '%s  %5s  %-8s  %s%s\n' "$mt" "${sz:-?}" "$show" "${title:-(untitled)}" "$flag"
    done
}

cmd_marked() {
  local ids; ids="$(marked_ids | sort)"
  [ -n "$ids" ] || { echo "(nothing marked for deletion)"; return 0; }
  printf '%s\n' "$ids"
}

cmd_mark() {
  local q="${1:-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}}"
  [ -n "$q" ] || die "no session id given and no current session in the environment"
  local id rc=0
  id="$(all_ids | _resolve "$q")" || rc=$?
  [ "$rc" = 2 ] && exit 1
  { [ "$rc" = 0 ] && [ -n "$id" ]; } || die "no session matches '$q'"
  local t; t="$(transcript_for "$id")"
  [ -n "$t" ] || die "no transcript file found for '$id'"
  if [ -e "$t.delete" ]; then
    echo "already marked: $id"
  else
    : > "$t.delete"
    echo "marked for deletion: $id"
    echo "  removed when it next ends, or on next launch if it isn't live (never while live)."
  fi
}

cmd_unmark() {
  local q="${1:?usage: claude-session unmark <id>}"
  local id rc=0
  id="$(marked_ids | _resolve "$q")" || rc=$?
  [ "$rc" = 2 ] && exit 1
  { [ "$rc" = 0 ] && [ -n "$id" ]; } || die "no marked session matches '$q'"
  local t; t="$(transcript_for "$id")"
  if [ -n "$t" ]; then
    rm -f -- "$t.delete"
  else
    find "$PROJECTS_DIR" -maxdepth 2 -name "$id.jsonl.delete" -delete 2>/dev/null || true
  fi
  echo "unmarked: $id"
}

cmd_delete() {
  local force=0
  case "${1:-}" in -f|--force) force=1; shift;; esac
  [ "$#" -ge 1 ] || die "usage: claude-session delete [-f] <id> [id...]"
  local live; live="$(live_ids)"
  local q id rc p found t err=0
  for q in "$@"; do
    rc=0; id="$(all_ids | _resolve "$q")" || rc=$?
    [ "$rc" = 2 ] && { err=1; continue; }           # ambiguous — candidates already listed
    if [ "$rc" != 0 ] || [ -z "$id" ]; then echo "not found: $q"; err=1; continue; fi
    if [ "$force" != 1 ] && printf '%s\n' "$live" | grep -qxF "$id"; then
      echo "refusing: '$id' looks LIVE (a Claude Code session is running it)." >&2
      echo "  use 'mark' to delete it safely on next launch, or 'delete -f' to force." >&2
      err=1; continue
    fi
    t="$(transcript_for "$id")"
    found=0
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      rm -rf -- "$p"; found=1
    done < <(paths_for "$id")
    [ -n "$t" ] && rm -f -- "$t.delete"             # drop the marker too, if any
    if [ "$found" = 1 ]; then echo "deleted: $id"; else echo "not found: $id"; err=1; fi
  done
  return "$err"
}

cmd_reap() {
  local current="${1:-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}}"
  local live; live="$( { live_ids; if [ -n "$current" ]; then printf '%s\n' "$current"; fi; } | sort -u )"
  local marker id t side reaped=0
  while IFS= read -r marker; do
    [ -n "$marker" ] || continue
    id="$(basename "$marker" .jsonl.delete)"
    if printf '%s\n' "$live" | grep -qxF "$id"; then continue; fi   # never touch a live session
    t="${marker%.delete}"                                          # the .jsonl transcript
    rm -f -- "$t" "$marker"
    side="${t%.jsonl}"                                             # optional sidecar dir
    if [ "$side" != "$t" ] && [ -d "$side" ]; then rm -rf -- "$side"; fi
    reaped=$((reaped+1))
    echo "claude-session: reaped $id" >&2
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl.delete' 2>/dev/null)
  [ "$reaped" -gt 0 ] && echo "claude-session: reaped $reaped marked session(s)" >&2
  return 0
}

# Dispatch only when executed directly, so helpers can be sourced for testing.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  sub="${1:-list}"; shift || true
  case "$sub" in
    list)   cmd_list "$@";;
    marked) cmd_marked "$@";;
    mark)   cmd_mark "$@";;
    unmark) cmd_unmark "$@";;
    delete) cmd_delete "$@";;
    reap)   cmd_reap "$@";;
    -h|--help|help) awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0";;
    *) die "unknown subcommand '$sub' (try: list mark unmark marked delete reap)";;
  esac
fi
