#!/usr/bin/env bash
# claude-session — manage Claude Code session transcripts (all projects on this machine).
#
# Sessions are stored as  ~/.claude/projects/<encoded-cwd>/<uuid>.jsonl
# (plus an optional <uuid>/ sidecar dir). Deletion intent is recorded as a
# marker file "<uuid>.jsonl.delete" next to the transcript. A marked transcript
# is removed when its session next ends (SessionEnd hook) or, if the session
# isn't live, on the next Claude Code launch (SessionStart reap) — never while
# it is still live.
#
# Deletion is RECOVERABLE: transcripts are moved to a trash
# (~/.claude/trash/<date>/<project>/) and auto-purged after 30 days, and every
# removal is appended to a tombstone log (~/.claude/session-deletions.log).
# `archive` keeps a compressed copy outside ~/.claude/projects, where Claude
# Code's own cleanupPeriodDays expiry cannot reach it.
#
# An <id> is a full session UUID or any unambiguous PREFIX of one — e.g. the
# short id shown by `list` (the first block). An ambiguous prefix is rejected
# and its candidates are listed, so nothing is deleted by guess.
#
# The tabular listings (list, trash, archived, orphans, log) print a column
# HEADER when stdout is a TTY and omit it when piped, so scripted use stays
# machine-readable; --header / --no-header force it either way. `marked` is
# deliberately a bare id list — no header, no columns — for `while read id`.
#
# Subcommands:
#   list [opts]          sessions newest-first: date · size · short-id · project · title
#                        every session, ACTIVE ones first then a dim "archived"
#                        divider and the rest; --active lists only the active
#                        -l/--long full UUIDs · --ids bare UUIDs · --marked · --live
#                        --project <name|path> selects a project and every
#                        sub-project below it · --match <substr> raw substring
#                        --since <date> · --limit <n>
#   projects             projects and sub-projects, with session counts
#   resume [opts] <id>   re-enter a session: cd to the project dir recorded in its
#                        own transcript, then exec `claude --resume <full-uuid>`
#                        (which needs the complete id AND the matching cwd)
#                        -n/--dry-run prints the command · -f/--force overrides the
#                        LIVE/MARKED guards · extra args are passed through to claude
#   mark   [<id>]        mark a session for deletion (default: the current session)
#   unmark <id>          remove a session's deletion marker
#   marked               list sessions currently marked for deletion
#   delete [opts] <id>…  delete now → trash; --purge unlinks outright (unrecoverable);
#                        refuses a LIVE session unless -f/--force
#                        --project <name|path> deletes a project and all its
#                        sub-projects — refuses without --yes; -n lists the set
#   reap   [<current>]   trash every MARKED, non-live session (SessionStart hook)
#   end    <transcript>  marker-gated removal of one transcript (SessionEnd hook)
#
#   trash                list trashed sessions and when each expires
#   restore <id>         bring a session back from the trash (or from the archive)
#   purge [opts]         drop expired trash; --older-than <n> · --all · -n/--dry-run
#   archive [opts]       gzip transcripts into ~/.claude/archive (keeps the original)
#                        --older-than <n> · --prune · --auto · -n/--dry-run
#   archived             list archived sessions
#
#   history <id> [opts]  replay a session's PROMPTS from ~/.claude/history.jsonl —
#                        works even when the transcript is gone. --oneline · -n <n>
#   orphans              sessions present in history.jsonl with no transcript anywhere
#   log [-n <n>]         show the tombstone log (what was removed, when, by which path)
#   doctor               audit the invariants that keep transcripts alive
#
# Env overrides: CLAUDE_PROJECTS_DIR, CLAUDE_SESSIONS_DIR, CLAUDE_SESSION_ID,
#   CLAUDE_SESSION_TRASH, CLAUDE_SESSION_ARCHIVE, CLAUDE_SESSION_LOG,
#   CLAUDE_HISTORY_FILE, CLAUDE_SETTINGS_FILE, CLAUDE_SESSION_CACHE,
#   CLAUDE_SESSION_REPO, CLAUDE_SESSION_TRASH_TTL_DAYS,
#   CLAUDE_SESSION_ARCHIVE_MIN_AGE_DAYS.
# NOTE: deliberately NOT `set -o pipefail`. This script is full of `… | head -1`
# idioms; on a large transcript the upstream stage takes SIGPIPE when `head` exits
# early, and pipefail would turn that into a fatal 141 under `set -e` — which
# silently truncated `list` output partway down. Statuses are checked explicitly.
set -eu

PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
LIVE_REGISTRY="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
TRASH_DIR="${CLAUDE_SESSION_TRASH:-$HOME/.claude/trash}"
ARCHIVE_DIR="${CLAUDE_SESSION_ARCHIVE:-$HOME/.claude/archive}"
LOG_FILE="${CLAUDE_SESSION_LOG:-$HOME/.claude/session-deletions.log}"
HISTORY_FILE="${CLAUDE_HISTORY_FILE:-$HOME/.claude/history.jsonl}"
SETTINGS_FILE="${CLAUDE_SETTINGS_FILE:-$HOME/.claude/settings.json}"
CACHE_DIR="${CLAUDE_SESSION_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-session}"
REPO_DIR="${CLAUDE_SESSION_REPO:-$HOME/dev/frznn/linux-scripts/claude-session}"
TRASH_TTL_DAYS="${CLAUDE_SESSION_TRASH_TTL_DAYS:-30}"
ARCHIVE_MIN_AGE_DAYS="${CLAUDE_SESSION_ARCHIVE_MIN_AGE_DAYS:-1}"

if [ -t 1 ]; then C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_D=$'\033[2m'; C_0=$'\033[0m'; HEADER=1
else C_G=""; C_Y=""; C_R=""; C_D=""; C_0=""; HEADER=0; fi

die()     { echo "claude-session: $*" >&2; exit 1; }
have_jq() { command -v jq >/dev/null 2>&1; }

# ---------------------------------------------------------------- discovery --

# Emit the transcript file and sidecar dir belonging to a session id (if any).
paths_for() {
  local id="$1"
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 \( -name "$id.jsonl" -o -name "$id" \) 2>/dev/null || true
}

# The .jsonl transcript path for a session id ("" if none).
transcript_for() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name "$1.jsonl" 2>/dev/null | head -1
}

# Session ids that currently carry a .delete marker.
marked_ids() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl.delete' 2>/dev/null \
    | sed -e 's#.*/##' -e 's/\.jsonl\.delete$//'
}

# All known session ids (basenames of the transcript files).
all_ids() {
  [ -d "$PROJECTS_DIR" ] || return 0
  find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' -printf '%f\n' 2>/dev/null | sed 's/\.jsonl$//'
}

trashed_ids() {
  [ -d "$TRASH_DIR" ] || return 0
  find "$TRASH_DIR" -mindepth 3 -maxdepth 3 -name '*.jsonl' -printf '%f\n' 2>/dev/null | sed 's/\.jsonl$//'
}

# A session's <uuid>/ sidecar dir (tool-results/, subagents/ — overflow storage
# Claude Code writes when tool output is too big to inline) is NOT part of the
# .jsonl, so the transcript archive alone does not preserve it. It is archived
# beside the .gz as <uuid>.sidecar.tar.gz.
_sidecar_tar() { printf '%s/%s/%s.sidecar.tar.gz' "$ARCHIVE_DIR" "$1" "$2"; }

# ---------------------------------------------------------------- projects --
# A session's project is its recorded cwd — a real absolute path — so projects
# form a TREE: a session in ~/dev/fed-franz/dusk/dusk-testbed belongs to
# dusk-testbed AND to dusk AND to fed-franz. Selectors resolve a name or path
# fragment to ONE root path and then match on SEGMENT boundaries. That is what
# raw substring matching gets wrong: 'frznn' is a substring of every path under
# /home/frznn (85 of 88 sessions here), and 'apps' silently conflates
# ~/dev/frznn/apps with the unrelated ~/dev/machine/apps. --match keeps the
# substring behaviour for when it is actually what you want.

# Not every transcript carries a cwd record (3 of 87 here). The encoded dir name
# cannot be decoded back into a path — '-' stands for both a path separator and a
# literal dash, so '-home-frznn-dev-fed-franz-dusk' is unparseable on its own. But
# every transcript in one encoded dir was written from the SAME cwd, so a sibling
# that does have the record supplies it exactly. Without this a cwd-less session
# is invisible to --project, and `delete --project` would silently skip it.
declare -A _DIR_CWD=()
_DIR_CWD_BUILT=0
_build_dir_cwd() {
  [ "$_DIR_CWD_BUILT" = 1 ] && return 0
  local f d
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    d="$(_encdir "$f")"
    [ -n "${_DIR_CWD[$d]:-}" ] && continue
    meta_for "$f"
    [ -n "${META_CWD:-}" ] && _DIR_CWD[$d]="$META_CWD"
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' 2>/dev/null)
  _DIR_CWD_BUILT=1
}

# The project path for one transcript: its own cwd record, else a sibling's, else
# the raw encoded dir name (which displays, but matches no path query).
_proj_of() {
  local f="$1" d
  meta_for "$f"
  if [ -n "${META_CWD:-}" ]; then printf '%s\n' "$META_CWD"; return 0; fi
  _build_dir_cwd
  d="$(_encdir "$f")"
  printf '%s\n' "${_DIR_CWD[$d]:-$d}"
}

# Every session's project path, one line per session (duplicates intended).
_cwds() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    _proj_of "$f"
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' 2>/dev/null)
}

# Leading ~ expanded, trailing slashes stripped.
_norm_path() {
  local p="$1"
  case "$p" in "~") p="$HOME";; "~/"*) p="$HOME/${p#\~/}";; esac
  while [ "${#p}" -gt 1 ]; do case "$p" in */) p="${p%/}";; *) break;; esac; done
  printf '%s' "$p"
}

# Is $1 at or below $2? Compared on segment boundaries, never as a substring.
_is_under() {
  case "$1" in
    "$2")   return 0;;
    "$2"/*) return 0;;
    *)      return 1;;
  esac
}

# Root paths a project query resolves to, deduped:
#   absolute path     -> itself
#   fragment with '/' -> every cwd prefix ending in that segment sequence
#   bare name         -> every cwd prefix ending in a segment equal to it
_project_roots() {
  local q; q="$(_norm_path "$1")"
  case "$q" in /*) printf '%s\n' "$q"; return 0;; esac
  local cwd pre seg rest
  _cwds | sort -u | while IFS= read -r cwd; do
    case "$cwd" in /*) :;; *) continue;; esac
    pre=""; rest="${cwd#/}"
    while [ -n "$rest" ]; do
      seg="${rest%%/*}"
      pre="$pre/$seg"
      case "$q" in
        */*) case "$pre" in */"$q") printf '%s\n' "$pre";; esac;;
        *)   [ "$seg" = "$q" ] && printf '%s\n' "$pre";;
      esac
      case "$rest" in *"/"*) rest="${rest#*/}";; *) rest="";; esac
    done
  done | sort -u
}

_count_under() {
  local root="$1" cwd c=0
  while IFS= read -r cwd; do
    [ -n "$cwd" ] || continue
    _is_under "$cwd" "$root" && c=$((c+1))
  done < <(_cwds)
  printf '%s' "$c"
}

# Resolve to exactly one project. When a name matches several and there is a
# terminal to ask on, offer a numbered choice; otherwise keep the never-guess
# contract and fail with the candidates listed. The non-interactive path is not
# a fallback nicety — the hooks (reap-sessions.sh, session-end-cleanup.sh) run
# this with stderr on /dev/null and no controlling tty, and a prompt there would
# hang session startup forever. Returns non-zero rather than exiting, so callers
# in $( ) see the failure; the chosen path goes to stdout, everything else to
# stderr, which keeps `list --ids | xargs …` clean while still being promptable.
_project_root_or_die() {
  local q="$1" roots n r c i choice tries=0 interactive=0
  roots="$(_project_roots "$q")"
  n=0; [ -n "$roots" ] && n="$(printf '%s\n' "$roots" | grep -c . || true)"
  if [ "$n" = 0 ]; then
    echo "no project matches '$q' — try 'claude-session projects'" >&2
    return 1
  fi
  [ "$n" = 1 ] && { printf '%s\n' "$roots"; return 0; }

  local cand=()
  while IFS= read -r r; do [ -n "$r" ] && cand+=("$r"); done <<EOF
$roots
EOF

  # Only ask when stderr is a terminal AND a controlling tty can be opened for
  # reading — stdin may legitimately be a pipe here, so the answer is read from
  # /dev/tty, not stdin.
  # The brace group matters: `exec 3</dev/tty 2>/dev/null` is an exec with no
  # command, so BOTH redirections would apply permanently — silently sending
  # every later prompt to /dev/null. Confining 2>/dev/null to the group keeps
  # fd 3 (which does persist) without hijacking stderr.
  if [ -t 2 ] && { exec 3</dev/tty; } 2>/dev/null; then interactive=1; fi

  if [ "$interactive" != 1 ]; then
    echo "refusing: '$q' names $n projects." >&2
    for r in "${cand[@]}"; do
      c="$(_count_under "$r")"
      printf '  %-44s (%s session%s)\n' "$(short_path "$r" 44)" "$c" "$([ "$c" = 1 ] || printf s)" >&2
    done
    echo "Name one of them more fully (e.g. --project frznn/apps), or use --match" >&2
    echo "for a raw substring search." >&2
    return 1
  fi

  echo "'$q' names $n projects:" >&2
  i=0
  for r in "${cand[@]}"; do
    i=$((i+1)); c="$(_count_under "$r")"
    printf '  %2d) %-44s (%s session%s)\n' "$i" "$(short_path "$r" 44)" "$c" \
      "$([ "$c" = 1 ] || printf s)" >&2
  done
  while [ "$tries" -lt 3 ]; do
    tries=$((tries+1))
    printf 'Which project? [1-%s, q to cancel] ' "$n" >&2
    if ! IFS= read -r choice <&3; then echo >&2; break; fi
    case "$choice" in
      ''|q|Q)   echo "cancelled" >&2; exec 3<&-; return 1;;
      *[!0-9]*) ;;
      *)        if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
                  exec 3<&-
                  printf '%s\n' "${cand[$((choice-1))]}"
                  return 0
                fi;;
    esac
    echo "  not one of 1-$n" >&2
  done
  exec 3<&-
  echo "cancelled — no valid choice" >&2
  return 1
}

# Session ids in project $1 or any of its sub-projects.
_project_ids() {
  local root="$1" f id
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    _is_under "$(_proj_of "$f")" "$root" || continue
    id="${f##*/}"; printf '%s\n' "${id%.jsonl}"
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' 2>/dev/null)
}

archived_ids() {
  [ -d "$ARCHIVE_DIR" ] || return 0
  find "$ARCHIVE_DIR" -mindepth 2 -maxdepth 2 -name '*.jsonl.gz' -printf '%f\n' 2>/dev/null | sed 's/\.jsonl\.gz$//'
}

history_ids() {
  [ -r "$HISTORY_FILE" ] || return 0
  if have_jq; then
    jq -r '.sessionId // empty' "$HISTORY_FILE" 2>/dev/null | sort -u
  else
    sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HISTORY_FILE" | sort -u
  fi
}

# Resolve <query> against candidate ids on stdin. Prints the full id and returns
# 0 on an exact or unique-prefix match; returns 1 if nothing matches; or prints
# the candidates to stderr and returns 2 if the prefix is ambiguous.
_resolve() {
  local q="$1" line; local -a hits=()
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$line" = "$q" ] && { printf '%s\n' "$line"; return 0; }
    case "$line" in "$q"*) hits+=("$line");; esac
  done
  case "${#hits[@]}" in
    1) printf '%s\n' "${hits[0]}"; return 0;;
    0) return 1;;
    *) { echo "claude-session: ambiguous id '$q' — matches:"; printf '  %s\n' "${hits[@]}"; } >&2; return 2;;
  esac
}

# Resolve $1 against the id list produced by the function named in $2, or die.
resolve_or_die() {
  local q="$1" src="$2" what="${3:-session}" id rc=0
  id="$("$src" | _resolve "$q")" || rc=$?
  [ "$rc" = 2 ] && exit 1
  { [ "$rc" = 0 ] && [ -n "$id" ]; } || die "no $what matches '$q'"
  printf '%s\n' "$id"
}

# Session ids that are currently LIVE. Claude Code writes one
# ~/.claude/sessions/<pid>.json per running process (with its .sessionId); we
# trust an entry only if <pid> is still a running process (skips stale/crashed
# files). Also includes this command's own session from the environment.
live_ids() {
  {
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo "$CLAUDE_CODE_SESSION_ID"; fi
    if [ -n "${CLAUDE_SESSION_ID:-}" ]; then echo "$CLAUDE_SESSION_ID"; fi
    if [ -d "$LIVE_REGISTRY" ]; then
      local f pid sid
      for f in "$LIVE_REGISTRY"/*.json; do
        [ -e "$f" ] || continue
        pid="$(basename "$f" .json)"
        case "$pid" in *[!0-9]*|'') continue;; esac   # only numeric <pid>.json
        [ -d "/proc/$pid" ] || continue               # skip stale (dead pid)
        if have_jq; then
          sid="$(jq -r '.sessionId // empty' "$f" 2>/dev/null)"
        else
          sid="$(sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1)"
        fi
        if [ -n "$sid" ]; then echo "$sid"; fi
      done
    fi
  } | sort -u
}

# ------------------------------------------------------------------ helpers --

# Human-readable byte size, no subprocess.
hsize() {
  local b="${1:-0}"
  if   [ "$b" -ge 1048576 ]; then printf '%d.%dM' $((b/1048576)) $(( (b%1048576)*10/1048576 ))
  elif [ "$b" -ge 1024 ];    then printf '%dK' $((b/1024))
  else                            printf '%dB' "$b"; fi
}

# Abbreviate $HOME to ~ and clip to $2 chars (keeping the tail).
short_path() {
  local p="${1:-}" w="${2:-26}"
  case "$p" in "$HOME"/*) p="~${p#$HOME}";; "$HOME") p='~';; esac
  if [ "${#p}" -gt "$w" ]; then p="…${p: -$((w-1))}"; fi
  printf '%s' "$p"
}

# Column header for a tabular listing: dim + uppercase on a TTY, omitted when
# stdout is piped so scripted consumers keep seeing data rows only.
# $1 = the row's printf format (without the trailing \n), rest = the labels.
hdr() {
  [ "$HEADER" = 1 ] || return 0
  local fmt="$1"; shift
  local line; line="$(printf "$fmt" "$@")"
  printf '%s%s%s\n' "$C_D" "$line" "$C_0"
}

# The encoded project-dir name of a transcript path, via parameter expansion
# rather than basename/dirname: these dir names start with '-', which unguarded
# commands read as an option ("basename: invalid option -- 'h'").
_encdir() { local d="${1%/*}"; printf '%s' "${d##*/}"; }

# The single jq pass over a transcript: cwd records and ai-titles, nothing else.
META_JQ='
  if ((.cwd? // "") != "") then "C\t" + .cwd
  elif (.type? == "ai-title") then "T\t" + (.aiTitle // "")
  else empty end'

# Cache file name for one transcript. The same session id can exist three times
# over — live transcript, trashed copy, .gz archive — with different mtime+size,
# so each needs its own key or they invalidate one another on every run. A live
# transcript keeps the historical bare-id key, so the existing cache stays valid.
_meta_cache_key() {
  local f="$1" id
  case "$f" in
    *.jsonl.gz) id="${f##*/}"; printf '%s.gz' "${id%.jsonl.gz}"; return 0;;
  esac
  id="${f##*/}"; id="${id%.jsonl}"
  case "$f" in "$TRASH_DIR"/*) printf '%s.trash' "$id";; *) printf '%s' "$id";; esac
}

# Per-transcript metadata (cwd + AI title) in ONE jq pass, memoised in
# $CACHE_DIR keyed by mtime+size — `list` used to re-scan every transcript.
# Reads a plain .jsonl or a gzipped archive copy. Sets META_CWD / META_TITLE.
META_CWD=""; META_TITLE=""
meta_for() {
  local f="$1" sig cache out csig
  META_CWD=""; META_TITLE=""
  [ -r "$f" ] || return 0
  sig="$(stat -c '%Y %s' "$f" 2>/dev/null || echo '0 0')"
  cache="$CACHE_DIR/$(_meta_cache_key "$f").meta"
  if [ -r "$cache" ]; then
    { read -r csig || true; read -r META_CWD || true; read -r META_TITLE || true; } < "$cache"
    [ "${csig:-}" = "$sig" ] && return 0
    META_CWD=""; META_TITLE=""
  fi
  if have_jq; then
    case "$f" in
      *.gz) out="$(gzip -cd -- "$f" 2>/dev/null | jq -r "$META_JQ" 2>/dev/null || true)";;
      *)    out="$(jq -r "$META_JQ" "$f" 2>/dev/null || true)";;
    esac
    # first cwd + last title in a single pass (no `head`/`tail` pipe to break)
    local both
    both="$(printf '%s\n' "$out" | awk -F'\t' '
      $1=="C" && c=="" { c=$2 } $1=="T" { t=$2 }
      END { print c; print t }')"
    META_CWD="$(printf '%s' "$both" | sed -n 1p)"
    META_TITLE="$(printf '%s' "$both" | sed -n 2p)"
  fi
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
  printf '%s\n%s\n%s\n' "$sig" "$META_CWD" "$META_TITLE" > "$cache" 2>/dev/null || true
}

# The project + title columns, resolved the same way in EVERY listing: the
# transcript's own cwd record, falling back to the encoded dir name ($2).
# ROW_PROJ is the raw path, so callers can still substring-filter it before
# clipping it with short_path.
ROW_PROJ=""; ROW_TITLE=""
row_meta() {
  meta_for "$1"
  ROW_PROJ="${META_CWD:-${2:-?}}"
  ROW_TITLE="${META_TITLE:-(untitled)}"
}

# How many prompts ~/.claude/history.jsonl still holds for a session.
prompt_count() {
  local id="$1" n=0
  [ -r "$HISTORY_FILE" ] || { echo 0; return 0; }
  if have_jq; then
    n="$(jq -r --arg id "$id" 'select(.sessionId == $id) | 1' "$HISTORY_FILE" 2>/dev/null | wc -l | tr -d ' ')"
  else
    n="$(grep -cF "\"$id\"" "$HISTORY_FILE" 2>/dev/null || true)"
  fi
  echo "${n:-0}"
}

# One tombstone line per removal, so "what happened to X?" always has an answer.
# ts <TAB> action <TAB> id <TAB> project <TAB> bytes <TAB> prompts <TAB> source <TAB> title
log_event() {
  local ts; ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  local clean; clean="$(printf '%s' "${7:-}" | tr '\t\n' '  ')"
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$ts" "${1:-?}" "${2:-?}" "${3:-?}" "${4:-0}" "${5:-0}" "${6:-?}" "$clean" \
    >> "$LOG_FILE" 2>/dev/null || true
}

# Move one transcript (+ marker + sidecar) into the trash and record it.
# $1 = transcript path, $2 = source tag (mark/delete/reap/session-end/…).
trash_path() {
  local t="$1" src="${2:-?}" id proj day dest bytes prompts
  [ -f "$t" ] || return 1
  id="$(basename "$t" .jsonl)"
  proj="$(basename "$(dirname "$t")")"
  bytes="$(stat -c %s "$t" 2>/dev/null || echo 0)"
  prompts="$(prompt_count "$id")"
  meta_for "$t"
  day="$(date +%F)"
  dest="$TRASH_DIR/$day/$proj"
  mkdir -p "$dest" || return 1
  rm -rf -- "$dest/$id.jsonl" "$dest/$id"
  mv -f -- "$t" "$dest/$id.jsonl" || return 1
  local side="${t%.jsonl}"
  [ "$side" != "$t" ] && [ -d "$side" ] && mv -f -- "$side" "$dest/$id"
  rm -f -- "$t.delete" "$CACHE_DIR/$id.meta"
  log_event trash "$id" "${META_CWD:-$proj}" "$bytes" "$prompts" "$src" "$META_TITLE"
  return 0
}

# ------------------------------------------------------------------- list ----

cmd_list() {
  local long=0 only_marked=0 only_live=0 only_active=0 proj_query="" match_filter="" \
        since="" limit=0 ids_only=0 proj_root=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -l|--long)   long=1;;
      --active)    only_active=1;;
      --marked)    only_marked=1;;
      --live)      only_live=1;;
      --project)   proj_query="${2:?--project needs a project name or path}"; shift;;
      --match)     match_filter="${2:?--match needs a substring}"; shift;;
      --ids)       ids_only=1;;
      --since)     since="${2:?--since needs a date}"; shift;;
      --limit)     limit="${2:?--limit needs a number}"; shift;;
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session list [-l] [--active] [--ids] [--marked] [--live] [--project <name|path>] [--match <substr>] [--since <date>] [--limit <n>] [--header|--no-header]"; return 0;;
      *)           die "list: unknown option '$1'";;
    esac
    shift
  done
  local since_epoch=0
  if [ -n "$since" ]; then
    since_epoch="$(date -d "$since" +%s 2>/dev/null)" || die "list: unparseable --since '$since'"
  fi
  if [ -n "$proj_query" ]; then
    proj_root="$(_project_root_or_die "$proj_query")" || return 1
  fi
  local marked_list live_list; marked_list="$(marked_ids)"; live_list="$(live_ids)"
  local idw=8
  if [ "$long" = 1 ]; then idw=36; fi

  # Every session is listed; archived ones simply come last. "Archived" is the
  # same currency test cmd_archive uses (.gz newer than the transcript), so a
  # transcript that grew after it was archived counts as ACTIVE — it is not
  # actually covered — as does any LIVE session (see below).
  # Rows are buffered rather than printed as they are found, because the source
  # is one mtime-sorted stream and the two blocks have to come out in order.
  local act=() arc=() aid=() rid=()
  local epoch when bytes f id show flags gz line
  while IFS=$'\t' read -r epoch when bytes f; do
    [ -n "${f:-}" ] || continue
    id="$(basename "$f" .jsonl)"
    [ "$since_epoch" != 0 ] && [ "${epoch%.*}" -lt "$since_epoch" ] && continue
    flags=""
    printf '%s\n' "$marked_list" | grep -qxF "$id" && flags="$flags [MARKED]"
    printf '%s\n' "$live_list"   | grep -qxF "$id" && flags="$flags [LIVE]"
    [ "$only_marked" = 1 ] && case "$flags" in *MARKED*) :;; *) continue;; esac
    [ "$only_live"   = 1 ] && case "$flags" in *LIVE*)   :;; *) continue;; esac
    row_meta "$f" "$(_encdir "$f")"
    if [ -n "$proj_root" ]; then
      _is_under "$(_proj_of "$f")" "$proj_root" || continue
    fi
    if [ -n "$match_filter" ]; then case "$ROW_PROJ" in *"$match_filter"*) :;; *) continue;; esac; fi

    gz="$ARCHIVE_DIR/$(_encdir "$f")/$id.jsonl.gz"
    local archived=0
    if [ -f "$gz" ] && [ "$gz" -nt "$f" ]; then archived=1; fi
    # A LIVE session is active whatever the mtimes say. An idle one can pass the
    # currency test — its transcript has not grown since the last sweep — but it
    # will invalidate that copy the moment it writes again, and showing a running
    # session under "archived" reads as finished when it is not.
    case "$flags" in *LIVE*) archived=0;; esac
    [ "$only_active" = 1 ] && [ "$archived" = 1 ] && continue

    if [ "$long" = 1 ]; then show="$id"; else show="${id%%-*}"; fi
    line="$(printf '%s  %6s  %-*s  %-26s  %s%s' \
              "$when" "$(hsize "$bytes")" "$idw" "$show" \
              "$(short_path "$ROW_PROJ" 26)" "$ROW_TITLE" "$flags")"
    if [ "$archived" = 1 ]; then arc+=("$line"); rid+=("$id")
    else                        act+=("$line"); aid+=("$id"); fi
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' \
             -printf '%T@\t%TY-%Tm-%Td %TH:%TM\t%s\t%p\n' 2>/dev/null | sort -rn)

  local na=${#act[@]} nr=${#arc[@]} n=0
  if [ "$ids_only" = 1 ]; then
    for id in ${aid+"${aid[@]}"} ${rid+"${rid[@]}"}; do
      printf '%s\n' "$id"; n=$((n+1))
      [ "$limit" != 0 ] && [ "$n" -ge "$limit" ] && break
    done
    return 0
  fi
  if [ "$((na + nr))" = 0 ]; then echo "(no sessions match)"; return 0; fi

  hdr '%-16s  %6s  %-*s  %-26s  %s' DATE SIZE "$idw" ID PROJECT TITLE
  for line in ${act+"${act[@]}"}; do
    printf '%s\n' "$line"; n=$((n+1))
    [ "$limit" != 0 ] && [ "$n" -ge "$limit" ] && { return 0; }
  done
  [ "$nr" = 0 ] && return 0
  # The divider counts the rows that actually follow, not the whole archived set:
  # under --limit it would otherwise announce 80 and then print two.
  local show_nr=$nr rem
  if [ "$limit" != 0 ]; then
    rem=$((limit - n)); [ "$rem" -lt 0 ] && rem=0
    [ "$show_nr" -gt "$rem" ] && show_nr=$rem
  fi
  [ "$show_nr" = 0 ] && return 0
  if [ "$show_nr" -lt "$nr" ]; then hdr '── archived (%s of %s) ──' "$show_nr" "$nr"
  else                              hdr '── archived (%s) ──' "$nr"; fi
  for line in ${arc+"${arc[@]}"}; do
    printf '%s\n' "$line"; n=$((n+1))
    [ "$limit" != 0 ] && [ "$n" -ge "$limit" ] && break
  done
  return 0
}

cmd_projects() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session projects [--header|--no-header]"; return 0;;
      *)           die "projects: unknown option '$1'";;
    esac
    shift
  done
  local cwds; cwds="$(_cwds)"
  [ -n "$cwds" ] || { echo "(no sessions)"; return 0; }
  # SESSIONS = sessions in this project itself ('-' when it only holds sub-projects)
  # TOTAL    = it plus every sub-project — the number `--project <it>` selects.
  # A project is listed when it holds sessions or branches into >=2 sub-projects,
  # so pass-through directories collapse into their child's name instead of
  # padding the tree with levels you can never usefully name.
  local depth label own tot n=0 indent i disp
  while IFS="$(printf '\t')" read -r depth label own tot; do
    [ -n "$label" ] || continue
    if [ "$n" = 0 ]; then hdr '%8s  %6s  %s' SESSIONS TOTAL PROJECT; fi
    indent=""; i=0
    while [ "$i" -lt "$depth" ]; do indent="$indent  "; i=$((i+1)); done
    disp="$label"; [ "$depth" = 0 ] && disp="$(short_path "$label" 48)"
    printf '%8s  %6s  %s%s\n' "$own" "$tot" "$indent" "$disp"
    n=$((n+1))
  done < <(printf '%s\n' "$cwds" | awk '
    {
      own[$0]++
      n = split($0, seg, "/")
      pre = ""
      for (i = 2; i <= n; i++) { pre = pre "/" seg[i]; total[pre]++; node[pre] = 1 }
    }
    END {
      for (p in node) {
        par = p; sub(/\/[^\/]*$/, "", par); if (par == "") par = "/"
        nchild[par]++
      }
      m = 0
      for (p in node)
        if (p != "/" && (own[p] > 0 || nchild[p] >= 2)) shown[++m] = p
      # lexicographic order puts every project ahead of its sub-projects, which
      # is what lets the stack below find each ones nearest listed parent.
      for (i = 1; i <= m; i++)
        for (j = i + 1; j <= m; j++)
          if (shown[j] < shown[i]) { t = shown[i]; shown[i] = shown[j]; shown[j] = t }
      sp = 0
      for (i = 1; i <= m; i++) {
        p = shown[i]
        while (sp > 0 && index(p, stack[sp] "/") != 1) sp--
        label = (sp > 0) ? substr(p, length(stack[sp]) + 2) : p
        printf "%s\t%s\t%s\t%s\n", sp, label, (own[p] ? own[p] : "-"), total[p]
        stack[++sp] = p
      }
    }')
  [ "$n" = 0 ] && echo "(no sessions)"
  return 0
}

cmd_marked() {
  local ids; ids="$(marked_ids | sort)"
  [ -n "$ids" ] || { echo "(nothing marked for deletion)"; return 0; }
  printf '%s\n' "$ids"
}

cmd_mark() {
  local q="${1:-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}}"
  [ -n "$q" ] || die "no session id given and no current session in the environment"
  local id; id="$(resolve_or_die "$q" all_ids session)"
  local t; t="$(transcript_for "$id")"
  [ -n "$t" ] || die "no transcript file found for '$id'"
  if [ -e "$t.delete" ]; then
    echo "already marked: $id"
  else
    : > "$t.delete"
    echo "marked for deletion: $id"
    echo "  moved to the trash when it next ends, or on next launch if it isn't live (never while live)."
    echo "  recoverable with 'claude-session restore $id' for $TRASH_TTL_DAYS days."
  fi
}

cmd_unmark() {
  local q="${1:?usage: claude-session unmark <id>}"
  local id; id="$(resolve_or_die "$q" marked_ids "marked session")"
  local t; t="$(transcript_for "$id")"
  if [ -n "$t" ]; then
    rm -f -- "$t.delete"
  else
    find "$PROJECTS_DIR" -maxdepth 2 -name "$id.jsonl.delete" -delete 2>/dev/null || true
  fi
  echo "unmarked: $id"
}

cmd_delete() {
  local force=0 purge=0 proj_q="" yes=0 dry=0 root="" ids="" nid=0 nsub=0 c sub_txt=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--force) force=1;;
      --purge)    purge=1;;
      --project)  proj_q="${2:?--project needs a project name or path}"; shift;;
      --yes)      yes=1;;
      -n|--dry-run) dry=1;;
      -*)         die "delete: unknown option '$1'";;
      *)          break;;
    esac
    shift
  done

  # Deleting a project takes its sub-projects with it, and unlike the <id> form
  # there is no explicit list acting as its own confirmation — so it is gated:
  # refuse and state the blast radius unless --yes, with -n to see the exact set.
  if [ -n "$proj_q" ]; then
    [ "$#" = 0 ] || die "delete: --project takes no <id> arguments"
    root="$(_project_root_or_die "$proj_q")" || return 1
    ids="$(_project_ids "$root")"
    [ -n "$ids" ] && nid="$(printf '%s\n' "$ids" | grep -c .)"
    [ "$nid" = 0 ] && { echo "project $(short_path "$root" 60) has no sessions"; return 0; }
    # Sub-projects are the distinct project paths strictly below the root — the
    # root's own sessions do not make it a sub-project of itself.
    nsub="$({ while IFS= read -r c; do
                [ -n "$c" ] || continue
                [ "$c" = "$root" ] && continue
                _is_under "$c" "$root" && printf '%s\n' "$c"
              done < <(_cwds); } | sort -u | grep -c . || true)"
    [ "$nsub" -gt 0 ] && sub_txt=" across $nsub sub-project(s)"
    if [ "$dry" = 1 ]; then
      echo "would delete project $(short_path "$root" 60): $nid session(s)$sub_txt"
      # Pass the RESOLVED path, not the original query: an absolute path can only
      # name one project, so the dry-run listing never re-asks what was just answered.
      cmd_list --project "$root" --header
      return 0
    fi
    if [ "$yes" != 1 ]; then
      echo "refusing: project $(short_path "$root" 60) holds $nid session(s)$sub_txt." >&2
      echo "Re-run with --yes to delete it, or -n to list what it would take." >&2
      return 1
    fi
    set -- $ids
  fi

  [ "$#" -ge 1 ] || die "usage: claude-session delete [-f] [--purge] <id> [id...]
   or: claude-session delete --project <name|path> [--yes|-n] [-f] [--purge]"
  local live; live="$(live_ids)"
  local q id rc t err=0
  for q in "$@"; do
    rc=0; id="$(all_ids | _resolve "$q")" || rc=$?
    [ "$rc" = 2 ] && { err=1; continue; }           # ambiguous — candidates already listed
    if [ "$rc" != 0 ] || [ -z "$id" ]; then echo "not found: $q"; err=1; continue; fi
    if [ "$force" != 1 ] && printf '%s\n' "$live" | grep -qxF "$id"; then
      echo "refusing: '$id' looks LIVE (a Claude Code session is running it)." >&2
      echo "  use 'mark' to delete it safely on next launch, or 'delete -f' to force." >&2
      err=1; continue
    fi
    t="$(transcript_for "$id")"
    if [ -z "$t" ]; then echo "not found: $id"; err=1; continue; fi
    if [ "$purge" = 1 ]; then
      local bytes prompts proj
      bytes="$(stat -c %s "$t" 2>/dev/null || echo 0)"
      prompts="$(prompt_count "$id")"; proj="$(basename "$(dirname "$t")")"
      meta_for "$t"
      local p
      while IFS= read -r p; do [ -n "$p" ] || continue; rm -rf -- "$p"; done < <(paths_for "$id")
      rm -f -- "$t.delete" "$CACHE_DIR/$id.meta"
      log_event purge "$id" "${META_CWD:-$proj}" "$bytes" "$prompts" "delete --purge" "$META_TITLE"
      echo "purged (unrecoverable): $id"
    else
      trash_path "$t" delete && echo "trashed: $id  (restore with: claude-session restore $id)"
    fi
  done
  return "$err"
}

cmd_reap() {
  local current="${1:-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}}"
  local live; live="$( { live_ids; if [ -n "$current" ]; then printf '%s\n' "$current"; fi; } | sort -u )"
  local marker id t reaped=0
  while IFS= read -r marker; do
    [ -n "$marker" ] || continue
    id="$(basename "$marker" .jsonl.delete)"
    if printf '%s\n' "$live" | grep -qxF "$id"; then continue; fi   # never touch a live session
    t="${marker%.delete}"
    if [ -f "$t" ]; then
      trash_path "$t" reap || true
    else
      rm -f -- "$marker"                                            # stale marker, no transcript
    fi
    reaped=$((reaped+1))
    echo "claude-session: reaped $id" >&2
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl.delete' 2>/dev/null)
  [ "$reaped" -gt 0 ] && echo "claude-session: reaped $reaped marked session(s) to the trash" >&2
  return 0
}

# SessionEnd hook path: the session has just ended, so it is safe to act on its
# own transcript — no live guard here, unlike `reap`.
cmd_end() {
  local t="${1:?usage: claude-session end <transcript-path>}"
  [ -f "$t.delete" ] || return 0
  if [ -f "$t" ]; then trash_path "$t" session-end || true; else rm -f -- "$t.delete"; fi
  return 0
}

# ----------------------------------------------------------------- resume ----

# Re-enter a session. `claude --resume` needs the COMPLETE uuid and only finds
# sessions whose recorded cwd matches the current directory, so resuming by hand
# means `list -l`, then `cd`, then resume. This resolves a prefix to the full id,
# reads the project cwd out of the transcript itself, and execs claude there —
# exec, so the user lands in the real interactive session on a clean TTY.
cmd_resume() {
  local dry=0 force=0 q=""
  local -a extra=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry=1;;
      -f|--force)   force=1;;
      -h|--help)    echo "usage: claude-session resume [-n] [-f] <id> [claude args...]"; return 0;;
      --)           shift; while [ "$#" -gt 0 ]; do extra+=("$1"); shift; done; break;;
      *)            if [ -z "$q" ]; then q="$1"; else extra+=("$1"); fi;;
    esac
    shift
  done
  [ -n "$q" ] || die "usage: claude-session resume [-n] [-f] <id> [claude args...]"

  # Same prefix resolution as delete/mark: exact, unique-prefix, or refuse.
  local id rc=0
  id="$(all_ids | _resolve "$q")" || rc=$?
  [ "$rc" = 2 ] && exit 1                          # ambiguous — candidates listed
  if [ "$rc" != 0 ] || [ -z "$id" ]; then
    local alt rc2=0
    alt="$(_restorable_ids | _resolve "$q")" || rc2=$?
    if [ "$rc2" = 0 ] && [ -n "${alt:-}" ]; then
      die "'$alt' has no transcript in $PROJECTS_DIR — bring it back first: claude-session restore $alt"
    fi
    die "no session matches '$q'"
  fi

  local t; t="$(transcript_for "$id")"
  [ -n "$t" ] || die "no transcript file found for '$id'"

  if [ "$force" != 1 ]; then
    if printf '%s\n' "$(live_ids)" | grep -qxF "$id"; then
      echo "refusing: '$id' is LIVE (a Claude Code session is running it)." >&2
      echo "  two clients appending to one transcript would corrupt it — close that session" >&2
      echo "  first, or pass -f to resume it anyway." >&2
      exit 1
    fi
    if [ -e "$t.delete" ]; then
      echo "refusing: '$id' is MARKED for deletion — it moves to the trash when it next ends," >&2
      echo "  so anything you do in it would be thrown away. Keep it with" >&2
      echo "  'claude-session unmark $id' first, or pass -f to resume it anyway." >&2
      exit 1
    fi
  fi

  # The project dir comes from the transcript's own cwd record — never guessed
  # from the encoded dir name, and never silently replaced by $PWD.
  meta_for "$t"
  if [ -z "$META_CWD" ]; then
    echo "claude-session: no cwd recorded in the transcript for '$id'." >&2
    echo "  cd to the session's project dir yourself and run: claude --resume $id" >&2
    exit 1
  fi
  if [ ! -d "$META_CWD" ]; then
    echo "claude-session: the project dir recorded for '$id' no longer exists:" >&2
    echo "    $META_CWD" >&2
    echo "  'claude --resume' only finds a session from its own cwd, so resuming from anywhere" >&2
    echo "  else would silently be the wrong directory. Recreate that path, or run" >&2
    echo "  'claude --resume $id' from wherever the project lives now." >&2
    exit 1
  fi

  if [ "$dry" = 1 ]; then
    local shown a
    shown="$(printf 'cd %q && claude --resume %s' "$META_CWD" "$id")"
    for a in ${extra[@]+"${extra[@]}"}; do shown="$shown $(printf '%q' "$a")"; done
    printf '%s\n' "$shown"
    return 0
  fi

  command -v claude >/dev/null 2>&1 || die "claude is not on PATH"
  printf 'resuming %s  %s  %s\n' \
    "${id%%-*}" "$(short_path "$META_CWD" 40)" "${META_TITLE:-(untitled)}" >&2
  cd "$META_CWD" || die "cannot cd to $META_CWD"
  exec claude --resume "$id" ${extra[@]+"${extra[@]}"}
}

# ------------------------------------------------------------------ trash ----

cmd_trash() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session trash [--header|--no-header]"; return 0;;
      *)           die "trash: unknown option '$1'";;
    esac
    shift
  done
  [ -d "$TRASH_DIR" ] || { echo "(trash is empty)"; return 0; }
  local n=0 day id f bytes left day_epoch
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    id="$(basename "$f" .jsonl)"
    day="$(basename "$(dirname "$(dirname "$f")")")"
    bytes="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    left="?"
    if day_epoch="$(date -d "$day" +%s 2>/dev/null)"; then
      left=$(( (day_epoch + TRASH_TTL_DAYS*86400 - $(date +%s)) / 86400 ))
      if [ "$left" -lt 0 ]; then left=0; fi
      left="${left}d"
    fi
    row_meta "$f" "$(_encdir "$f")"
    if [ "$n" = 0 ]; then hdr '%-10s  %6s  %-8s  %-26s  %-7s  %s' DATE SIZE ID PROJECT EXPIRES TITLE; fi
    printf '%s  %6s  %-8s  %-26s  %-7s  %s\n' \
      "$day" "$(hsize "$bytes")" "${id%%-*}" "$(short_path "$ROW_PROJ" 26)" "$left" "$ROW_TITLE"
    n=$((n+1))
  done < <(find "$TRASH_DIR" -mindepth 3 -maxdepth 3 -name '*.jsonl' 2>/dev/null | sort -r)
  [ "$n" = 0 ] && echo "(trash is empty)"
  return 0
}

cmd_restore() {
  local q="${1:?usage: claude-session restore <id>}"
  local id; id="$(resolve_or_die "$q" _restorable_ids "trashed or archived session")"
  local dest_dir dest src proj

  # Trash first (a full transcript beats a compressed copy of an older one).
  src="$(find "$TRASH_DIR" -mindepth 3 -maxdepth 3 -name "$id.jsonl" 2>/dev/null | sort -r | head -1)"
  if [ -n "$src" ]; then
    proj="$(basename "$(dirname "$src")")"
    dest_dir="$PROJECTS_DIR/$proj"; dest="$dest_dir/$id.jsonl"
    [ -e "$dest" ] && die "a transcript already exists at $dest — not overwriting"
    mkdir -p "$dest_dir"
    mv -f -- "$src" "$dest"
    local side="${src%.jsonl}"
    [ -d "$side" ] && mv -f -- "$side" "$dest_dir/$id"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$src")" 2>/dev/null || true
    log_event restore "$id" "$proj" "$(stat -c %s "$dest" 2>/dev/null || echo 0)" \
      "$(prompt_count "$id")" trash ""
    echo "restored from trash: $id → $dest"
    return 0
  fi

  # Fall back to the archive (decompress a copy; the .gz stays put).
  src="$(find "$ARCHIVE_DIR" -mindepth 2 -maxdepth 2 -name "$id.jsonl.gz" 2>/dev/null | head -1)"
  [ -n "$src" ] || die "no trashed or archived copy of '$id'"
  proj="$(basename "$(dirname "$src")")"
  dest_dir="$PROJECTS_DIR/$proj"; dest="$dest_dir/$id.jsonl"
  [ -e "$dest" ] && die "a transcript already exists at $dest — not overwriting"
  mkdir -p "$dest_dir"
  gunzip -c -- "$src" > "$dest.part" && mv -f -- "$dest.part" "$dest"
  local tar="$(_sidecar_tar "$proj" "$id")" side_note=""
  if [ -f "$tar" ] && [ ! -d "$dest_dir/$id" ]; then
    if mkdir -p "$dest_dir/$id" && tar -xzf "$tar" -C "$dest_dir/$id" 2>/dev/null; then
      side_note=" (+sidecar)"
    else
      rmdir "$dest_dir/$id" 2>/dev/null || true
      echo "warning: sidecar tarball present but could not be unpacked: $tar" >&2
    fi
  fi
  log_event restore "$id" "$proj" "$(stat -c %s "$dest" 2>/dev/null || echo 0)" \
    "$(prompt_count "$id")" archive ""
  echo "restored from archive: $id → $dest$side_note"
}

_restorable_ids() { { trashed_ids; archived_ids; } | sort -u; }

cmd_purge() {
  local older="$TRASH_TTL_DAYS" all=0 dry=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --older-than) older="${2:?--older-than needs a number of days}"; shift;;
      --all)        all=1;;
      -n|--dry-run) dry=1;;
      --expired)    :;;                     # the default; accepted for clarity in hooks
      *)            die "purge: unknown option '$1'";;
    esac
    shift
  done
  [ -d "$TRASH_DIR" ] || return 0
  local now cutoff d day d_epoch f id proj bytes n=0
  now="$(date +%s)"; cutoff=$(( now - older*86400 ))
  for d in "$TRASH_DIR"/*/; do
    [ -d "$d" ] || continue
    day="$(basename "$d")"
    if [ "$all" != 1 ]; then
      d_epoch="$(date -d "$day" +%s 2>/dev/null)" || continue     # unparseable name: leave it
      [ "$d_epoch" -ge "$cutoff" ] && continue
    fi
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      id="$(basename "$f" .jsonl)"; proj="$(basename "$(dirname "$f")")"
      bytes="$(stat -c %s "$f" 2>/dev/null || echo 0)"
      if [ "$dry" = 1 ]; then
        echo "would purge: $day  ${id%%-*}  $proj  $(hsize "$bytes")"
      else
        log_event purge "$id" "$proj" "$bytes" "$(prompt_count "$id")" "trash-expiry(${older}d)" ""
      fi
      n=$((n+1))
    done < <(find "$d" -mindepth 2 -maxdepth 2 -name '*.jsonl' 2>/dev/null)
    [ "$dry" = 1 ] || rm -rf -- "$d"
  done
  if [ "$n" -gt 0 ] && [ "$dry" != 1 ]; then
    echo "claude-session: purged $n expired session(s) from the trash" >&2
  fi
  return 0
}

# ---------------------------------------------------------------- archive ----

cmd_archive() {
  local older="$ARCHIVE_MIN_AGE_DAYS" prune=0 dry=0 quiet=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --older-than) older="${2:?--older-than needs a number of days}"; shift;;
      --prune)      prune=1;;
      --auto)       quiet=1;;
      -n|--dry-run) dry=1;;
      *)            die "archive: unknown option '$1'";;
    esac
    shift
  done
  local f id proj gz side tar n=0 np=0 need_j need_s what sfx
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    id="$(basename "$f" .jsonl)"; proj="$(basename "$(dirname "$f")")"
    gz="$ARCHIVE_DIR/$proj/$id.jsonl.gz"
    side="${f%.jsonl}"; tar="$(_sidecar_tar "$proj" "$id")"

    # Two independent pieces, each with its own currency test. A sidecar can gain
    # files while the transcript is untouched, so testing only the .jsonl would
    # leave the tarball permanently stale.
    need_j=1; [ -f "$gz" ] && [ "$gz" -nt "$f" ] && need_j=0
    need_s=0
    if [ -d "$side" ]; then
      if [ ! -f "$tar" ]; then need_s=1
      elif [ -n "$(find "$side" -newer "$tar" -print -quit 2>/dev/null)" ]; then need_s=1; fi
    fi

    if [ "$need_j" = 1 ] || [ "$need_s" = 1 ]; then
      what="transcript"; [ "$need_j" = 0 ] && what="sidecar"
      [ "$need_j" = 1 ] && [ "$need_s" = 1 ] && what="transcript+sidecar"
      if [ "$dry" = 1 ]; then
        echo "would archive: ${id%%-*}  $proj  ($what)"; n=$((n+1))
      else
        mkdir -p "$ARCHIVE_DIR/$proj" || continue
        if [ "$need_j" = 1 ]; then
          gzip -c -- "$f" > "$gz.part" 2>/dev/null && mv -f -- "$gz.part" "$gz" \
            || { rm -f -- "$gz.part"; continue; }
        fi
        if [ "$need_s" = 1 ]; then
          # -C "$side" . stores paths relative to the sidecar itself, so restore
          # can unpack into a freshly made <uuid>/ without trusting a stored name.
          if tar -czf "$tar.part" -C "$side" . 2>/dev/null; then
            mv -f -- "$tar.part" "$tar"
          else
            rm -f -- "$tar.part"
            echo "warning: could not archive sidecar for ${id%%-*} — not pruning it" >&2
            continue
          fi
        fi
        n=$((n+1))
        sfx=""; [ "$need_s" = 1 ] && sfx=" (+sidecar)"
        [ "$quiet" = 1 ] || echo "archived: ${id%%-*}  →  $gz$sfx"
      fi
    fi

    # --prune removes the original once a copy exists. It has to fire for a
    # session archived on an EARLIER run too: on a steady-state store everything
    # is already covered, so gating prune on "archived something just now" made
    # `archive --prune` a silent no-op. Never reached when archiving failed above.
    if [ "$prune" = 1 ]; then
      if [ "$dry" = 1 ]; then echo "would prune: ${id%%-*}  $proj"; np=$((np+1))
      elif trash_path "$f" archive-prune; then np=$((np+1)); fi
    fi
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' -mtime "+$older" 2>/dev/null)
  if [ "$quiet" != 1 ]; then
    if [ "$np" -gt 0 ]; then
      if [ "$dry" = 1 ]; then echo "would prune $np original(s) to the trash"
      else echo "pruned $np original(s) to the trash"; fi
    fi
    [ "$n" = 0 ] && [ "$np" = 0 ] && echo "(nothing to archive)"
  fi
  return 0
}

cmd_archived() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session archived [--header|--no-header]"; return 0;;
      *)           die "archived: unknown option '$1'";;
    esac
    shift
  done
  [ -d "$ARCHIVE_DIR" ] || { echo "(archive is empty)"; return 0; }
  local n=0 f id bytes when
  while IFS=$'\t' read -r when bytes f; do
    [ -n "${f:-}" ] || continue
    id="$(basename "$f" .jsonl.gz)"
    row_meta "$f" "$(_encdir "$f")"
    if [ "$n" = 0 ]; then hdr '%-16s  %6s  %-8s  %-26s  %s' DATE SIZE ID PROJECT TITLE; fi
    printf '%s  %6s  %-8s  %-26s  %s\n' \
      "$when" "$(hsize "$bytes")" "${id%%-*}" "$(short_path "$ROW_PROJ" 26)" "$ROW_TITLE"
    n=$((n+1))
  done < <(find "$ARCHIVE_DIR" -mindepth 2 -maxdepth 2 -name '*.jsonl.gz' \
             -printf '%TY-%Tm-%Td %TH:%TM\t%s\t%p\n' 2>/dev/null | sort -r)
  [ "$n" = 0 ] && echo "(archive is empty)"
  return 0
}

# ---------------------------------------------------- history / salvage ------

cmd_history() {
  local q="" oneline=0 limit=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --oneline) oneline=1;;
      -n|--limit) limit="${2:?-n needs a number}"; shift;;
      -*) die "history: unknown option '$1'";;
      *)  q="$1";;
    esac
    shift
  done
  [ -n "$q" ] || die "usage: claude-session history <id> [--oneline] [-n <n>]"
  [ -r "$HISTORY_FILE" ] || die "no history file at $HISTORY_FILE"
  have_jq || die "history needs jq"
  local id; id="$(resolve_or_die "$q" _known_ids "session")"
  local total; total="$(prompt_count "$id")"
  [ "$total" -gt 0 ] || die "no prompts recorded for '$id' in $(short_path "$HISTORY_FILE" 60)"
  local where="transcript present"
  [ -n "$(transcript_for "$id")" ] || where="TRANSCRIPT GONE — prompts only, no assistant replies"
  echo "session $id — $total prompt(s) — $where"
  echo
  local n=0 line ts disp
  while IFS=$'\t' read -r ts disp; do
    n=$((n+1))
    [ "$limit" != 0 ] && [ "$n" -gt "$limit" ] && { echo "… ($((total-limit)) more)"; break; }
    if [ "$oneline" = 1 ]; then
      printf '%s  %s\n' "$ts" "$(printf '%s' "$disp" | head -c 100)"
    else
      printf '\n%s── %s ─ #%d ──%s\n%s\n' "$C_D" "$ts" "$n" "$C_0" "$(printf '%b' "$disp")"
    fi
  done < <(jq -r --arg id "$id" '
      select(.sessionId == $id)
      | ((.timestamp / 1000) | strflocaltime("%Y-%m-%d %H:%M"))
        + "\t" + ((.display // "") | gsub("\n"; "\\n"))' "$HISTORY_FILE" 2>/dev/null)
}

_known_ids() { { all_ids; trashed_ids; archived_ids; history_ids; } | sort -u; }

cmd_orphans() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session orphans [--header|--no-header]"; return 0;;
      *)           die "orphans: unknown option '$1'";;
    esac
    shift
  done
  [ -r "$HISTORY_FILE" ] || die "no history file at $HISTORY_FILE"
  have_jq || die "orphans needs jq"
  local tmp_h tmp_have
  tmp_h="$(mktemp)"; tmp_have="$(mktemp)"
  trap 'rm -f "$tmp_h" "$tmp_have"' RETURN
  history_ids > "$tmp_h"
  { all_ids; trashed_ids; archived_ids; } | sort -u > "$tmp_have"
  local n=0 id
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    local info
    info="$(jq -r --arg id "$id" '
        select(.sessionId == $id)
        | [ (.timestamp/1000 | strflocaltime("%Y-%m-%d")), (.project // "?"), ((.display // "") | gsub("\n"; " ")) ]
        | @tsv' "$HISTORY_FILE" 2>/dev/null)"
    local first last proj label cnt
    first="$(printf '%s\n' "$info" | head -1 | cut -f1)"
    last="$(printf '%s\n' "$info"  | tail -1 | cut -f1)"
    proj="$(printf '%s\n' "$info"  | head -1 | cut -f2)"
    label="$(printf '%s\n' "$info" | head -1 | cut -f3 | head -c 44)"
    cnt="$(printf '%s\n' "$info" | grep -c . || true)"
    if [ "$n" = 0 ]; then
      hdr '%-8s  %5s  %-10s   %-10s  %-26s  %s' ID PRMT FROM TO PROJECT 'FIRST PROMPT'
    fi
    printf '%-8s  %5s  %s → %s  %-26s  %s\n' \
      "${id%%-*}" "$cnt" "$first" "$last" "$(short_path "$proj" 26)" "$label"
    n=$((n+1))
  done < <(comm -23 "$tmp_h" "$tmp_have")
  if [ "$n" = 0 ]; then
    echo "(no orphans — every session in history.jsonl still has a transcript, trash or archive copy)"
  else
    echo
    echo "$n session(s) survive only as prompts in $(short_path "$HISTORY_FILE" 60)."
    echo "Read one with: claude-session history <short-id>"
  fi
  return 0
}

cmd_log() {
  local limit=40
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n|--limit)  limit="${2:?-n needs a number}"; shift;;
      --header)    HEADER=1;;
      --no-header) HEADER=0;;
      -h|--help)   echo "usage: claude-session log [-n <n>] [--header|--no-header]"; return 0;;
      *)           die "log: unknown option '$1'";;
    esac
    shift
  done
  [ -r "$LOG_FILE" ] || { echo "(no removals recorded yet — $LOG_FILE does not exist)"; return 0; }
  hdr '%-16s  %-8s  %-8s  %6s  %5s  %-18s  %-22s  %s' WHEN ACTION ID SIZE PRMT SOURCE PROJECT TITLE
  tail -n "$limit" "$LOG_FILE" | while IFS=$'\t' read -r ts action id proj bytes prompts src title; do
    printf '%-16s  %-8s  %-8s  %6s  %5s  %-18s  %-22s  %s\n' \
      "${ts:0:16}" "$action" "${id%%-*}" "$(hsize "${bytes:-0}")" "${prompts:-0}" "${src:-?}" \
      "$(short_path "${proj:-?}" 22)" "${title:-}"
  done
}

# ----------------------------------------------------------------- doctor ----

DOC_FAIL=0
_ok()   { printf '  %sok%s    %s\n' "$C_G" "$C_0" "$*"; }
_warn() { printf '  %swarn%s  %s\n' "$C_Y" "$C_0" "$*"; }
_fail() { printf '  %sFAIL%s  %s\n' "$C_R" "$C_0" "$*"; DOC_FAIL=1; }

# Expand a leading ~ and take the command word out of a hook command string.
_hook_path() { local c="${1:-}"; c="${c%% *}"; case "$c" in "~"*) c="$HOME${c#\~}";; esac; printf '%s' "$c"; }

# Compare one repo file against the copy that is actually in use.
#   _drift <repo file> <in-use file> <install|reconcile> [label]
# "install" prescribes a direction: the repo is upstream of that path by
# definition, because this README is what puts the file there. "reconcile" stays
# direction-neutral — a hook may be canonical somewhere else and this copy the
# derived one, so report the divergence and let a human decide which way it goes.
_drift() {
  local src="$1" dst="$2" mode="$3" label="${4:-${2##*/}}"
  if [ ! -f "$src" ];             then _warn "no repo copy of ${src##*/}"
  elif [ ! -f "$dst" ];           then _warn "not installed: $dst"
  elif cmp -s "$src" "$dst";      then _ok   "$label matches the repo copy"
  elif [ "$mode" = install ];     then _fail "$label DIFFERS from the repo copy — reinstall with: install -Dm755 $src $dst"
  else                                 _fail "$label DIFFERS from the repo copy — reconcile: diff $src $dst"
  fi
}

cmd_doctor() {
  echo "settings ($SETTINGS_FILE)"
  if [ ! -r "$SETTINGS_FILE" ]; then
    _fail "unreadable — cannot verify cleanupPeriodDays or hook wiring"
  elif ! have_jq; then
    _warn "jq missing — skipping settings checks"
  else
    local cpd; cpd="$(jq -r '.cleanupPeriodDays // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
    if [ -z "$cpd" ]; then
      _fail "cleanupPeriodDays is UNSET — Claude Code defaults to 30 days and silently deletes older transcripts"
    elif [ "$cpd" -lt 365 ] 2>/dev/null; then
      _warn "cleanupPeriodDays = $cpd — transcripts older than that are deleted by Claude Code, not by this tool"
    else
      _ok "cleanupPeriodDays = $cpd"
    fi
    local ev hooks p found
    for ev in SessionStart SessionEnd; do
      hooks="$(jq -r --arg e "$ev" '.hooks[$e][]?.hooks[]?.command // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
      if [ -z "$hooks" ]; then
        _fail "$ev: no hook wired — marked sessions will never be removed"
        continue
      fi
      found=0
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        local abs; abs="$(_hook_path "$p")"
        if [ ! -e "$abs" ];      then _fail "$ev: '$p' does not exist"
        elif [ ! -x "$abs" ];    then _fail "$ev: '$p' is not executable"
        else found=1; fi
      done <<< "$hooks"
      [ "$found" = 1 ] && _ok "$ev: $(printf '%s' "$hooks" | grep -c .) hook(s) wired and executable"
    done
  fi

  echo "install"
  if [ ! -d "$REPO_DIR" ]; then
    _warn "repo not found at $REPO_DIR — skipping install-drift check"
  else
    # The CLI has exactly one install path, so check it directly.
    _drift "$REPO_DIR/claude-session" "$HOME/.local/bin/claude-session" install claude-session

    # Hooks are NOT checked at a fixed path. A hook can live anywhere; what
    # decides which copy actually runs is settings.json. So drift-check whatever
    # is wired there, pairing each wired command with a repo script of the same
    # name — a wired hook with no counterpart in the repo belongs to something
    # else and is left alone. This is what keeps the check honest on a machine
    # that installs a hook outside ~/.claude/hooks.
    if ! have_jq || [ ! -r "$SETTINGS_FILE" ]; then
      _warn "settings unreadable or jq missing — wired hooks not drift-checked"
    else
      local ev cmdline abs hsrc n_hooks=0
      for ev in SessionStart SessionEnd; do
        while IFS= read -r cmdline; do
          [ -n "$cmdline" ] || continue
          abs="$(_hook_path "$cmdline")"
          hsrc="$REPO_DIR/${abs##*/}"
          [ -f "$hsrc" ] || continue
          n_hooks=$((n_hooks+1))
          _drift "$hsrc" "$abs" reconcile "${abs##*/} (wired $ev)"
        done <<< "$(jq -r --arg e "$ev" '.hooks[$e][]?.hooks[]?.command // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
      done
      if [ "$n_hooks" = 0 ]; then
        _warn "no wired hook matches a script in $REPO_DIR — hook drift not checked"
      fi
    fi
  fi

  echo "store"
  local n_tx n_marked stale=0 orphan_side=0 m t d
  n_tx="$(all_ids | grep -c . || true)"
  n_marked="$(marked_ids | grep -c . || true)"
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    [ -f "${m%.delete}" ] || stale=$((stale+1))
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl.delete' 2>/dev/null)
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$(basename "$d")" in memory) continue;; esac
    [ -f "$d.jsonl" ] || orphan_side=$((orphan_side+1))
  done < <(find "$PROJECTS_DIR" -mindepth 2 -maxdepth 2 -type d 2>/dev/null)
  _ok "$n_tx transcript(s), $n_marked marked for deletion"
  [ "$stale" -gt 0 ] && _warn "$stale marker(s) whose transcript is already gone (harmless; cleared on next reap)"
  [ "$orphan_side" -gt 0 ] && _warn "$orphan_side sidecar dir(s) with no transcript"

  echo "safety net"
  local tn ta; tn="$(trashed_ids | grep -c . || true)"; ta="$(archived_ids | grep -c . || true)"
  _ok "trash: $tn session(s), TTL ${TRASH_TTL_DAYS}d ($TRASH_DIR)"
  if [ "$ta" = 0 ]; then _warn "archive is empty — run 'claude-session archive' to keep copies outside ~/.claude/projects"
  else _ok "archive: $ta session(s) ($ARCHIVE_DIR)"; fi
  local unarch=0 f id proj
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    id="$(basename "$f" .jsonl)"; proj="$(basename "$(dirname "$f")")"
    [ -f "$ARCHIVE_DIR/$proj/$id.jsonl.gz" ] || unarch=$((unarch+1))
  done < <(find "$PROJECTS_DIR" -maxdepth 2 -name '*.jsonl' -mtime "+$ARCHIVE_MIN_AGE_DAYS" 2>/dev/null)
  [ "$unarch" -gt 0 ] && _warn "$unarch transcript(s) older than ${ARCHIVE_MIN_AGE_DAYS}d not archived yet"
  local nside=0 unside=0 sd sid sproj
  while IFS= read -r sd; do
    [ -n "$sd" ] || continue
    sid="$(basename "$sd")"; sproj="$(basename "$(dirname "$sd")")"
    [ -f "$PROJECTS_DIR/$sproj/$sid.jsonl" ] || continue      # orphan sidecar: reported above
    nside=$((nside+1))
    [ -f "$(_sidecar_tar "$sproj" "$sid")" ] || unside=$((unside+1))
  done < <(find "$PROJECTS_DIR" -mindepth 2 -maxdepth 2 -type d ! -name memory 2>/dev/null)
  if [ "$nside" = 0 ]; then :
  elif [ "$unside" -gt 0 ]; then
    _warn "$unside of $nside sidecar dir(s) not archived — 'archive' captures them as <id>.sidecar.tar.gz; prune before that loses them at trash expiry"
  else _ok "sidecars: $nside/$nside archived"; fi
  if [ -r "$LOG_FILE" ]; then _ok "tombstone log: $(grep -c . "$LOG_FILE" || true) entr(ies) ($LOG_FILE)"
  else _warn "no tombstone log yet ($LOG_FILE)"; fi

  echo "salvage"
  if [ -r "$HISTORY_FILE" ] && have_jq; then
    local h have orph
    h="$(history_ids | grep -c . || true)"
    have="$({ all_ids; trashed_ids; archived_ids; } | sort -u | grep -c . || true)"
    orph="$(comm -23 <(history_ids) <({ all_ids; trashed_ids; archived_ids; } | sort -u) | grep -c . || true)"
    if [ "$orph" -gt 0 ]; then
      _warn "$orph of $h session(s) in history.jsonl have no transcript — prompts only ('claude-session orphans')"
    else
      _ok "all $h session(s) in history.jsonl still have a copy ($have on disk)"
    fi
  else
    _warn "history.jsonl unreadable or jq missing — no prompt-level salvage available"
  fi

  echo
  if [ "$DOC_FAIL" = 1 ]; then echo "doctor: FAILURES above — transcripts are at risk."; return 1; fi
  echo "doctor: all good."
  return 0
}

# --------------------------------------------------------------- dispatch ----

# Dispatch only when executed directly, so helpers can be sourced for testing.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  sub="${1:-list}"; shift || true
  case "$sub" in
    list)     cmd_list "$@";;
    projects) cmd_projects "$@";;
    marked)   cmd_marked "$@";;
    mark)     cmd_mark "$@";;
    unmark)   cmd_unmark "$@";;
    delete)   cmd_delete "$@";;
    reap)     cmd_reap "$@";;
    end)      cmd_end "$@";;
    resume)   cmd_resume "$@";;
    trash)    cmd_trash "$@";;
    restore)  cmd_restore "$@";;
    purge)    cmd_purge "$@";;
    archive)  cmd_archive "$@";;
    archived) cmd_archived "$@";;
    history)  cmd_history "$@";;
    orphans)  cmd_orphans "$@";;
    log)      cmd_log "$@";;
    doctor)   cmd_doctor "$@";;
    -h|--help|help) awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0";;
    *) die "unknown subcommand '$sub' (try: list resume mark unmark marked delete reap trash restore purge archive archived history orphans log doctor)";;
  esac
fi
