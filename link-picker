#!/usr/bin/env bash
set -euo pipefail

URL_ARGS=("$@")

# --- single-click de-duplication (added 2026-08-19) --------------------------
# One click can reach this script TWICE: cosmic-term opens the link itself and
# a TUI app with mouse reporting (e.g. Claude Code) also opens it, ~0.6s apart.
# The terminal scrapes the rendered screen, so its URL can be a truncated
# prefix of the real one. Collapse prefix-related pairs into a single picker
# and keep the longest (complete) URL. Unrelated URLs are never collapsed, so
# two different links clicked in quick succession still get two pickers.
LP_STATE="${XDG_RUNTIME_DIR:-/tmp}/link-picker"
LP_DEDUPE=0
if [ $# -eq 1 ]; then
  LP_DEDUPE=1
  mkdir -p "$LP_STATE"
  chmod 700 "$LP_STATE"
  exec 9>"$LP_STATE/lock"
  flock 9
  lp_now=$(date +%s%N)
  lp_pid=""; lp_ts=0; lp_url=""
  if [ -r "$LP_STATE/current" ]; then
    read -r lp_pid lp_ts lp_url < "$LP_STATE/current" || true
  fi
  if [ -n "$lp_pid" ] && kill -0 "$lp_pid" 2>/dev/null \
     && [ "$(( (lp_now - lp_ts) / 1000000000 ))" -lt 2 ] \
     && [ -n "$lp_url" ] \
     && { [ "${1#"$lp_url"}" != "$1" ] || [ "${lp_url#"$1"}" != "$lp_url" ]; }; then
    # Same click as the live picker: hand over the better URL, show no window.
    if [ ${#1} -gt ${#lp_url} ]; then
      printf '%s %s %s\n' "$lp_pid" "$lp_ts" "$1" > "$LP_STATE/current"
    fi
    exit 0
  fi
  printf '%s %s %s\n' "$$" "$lp_now" "$1" > "$LP_STATE/current"
  flock -u 9
fi

# Geometry "WxH+X+Y" centered on the primary monitor (or first connected if no primary).
# NB: uses bash regex, not awk's 3-arg match() -- that is a gawk extension and
# /usr/bin/awk here is mawk, which fails to parse it (so this silently returned
# nothing and every window was left unpositioned). Fixed 2026-08-19.
geom() {
  local w=$1 h=$2 line
  line=$(xrandr --query 2>/dev/null | grep -m1 -E '^[A-Za-z0-9_-]+ connected primary') ||
    line=$(xrandr --query 2>/dev/null | grep -m1 -E '^[A-Za-z0-9_-]+ connected') ||
    return 0
  [[ $line =~ ([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+) ]] || return 0
  printf '%dx%d+%d+%d' "$w" "$h" \
    $(( BASH_REMATCH[3] + (BASH_REMATCH[1] - w) / 2 )) \
    $(( BASH_REMATCH[4] + (BASH_REMATCH[2] - h) / 2 ))
}

# --- the browsers ---------------------------------------------------------------
# The browsers offered come from a file, one per line, fields split by "|":
#   name | family | profile folder | command
# Family "chromium" reads its profiles from "<folder>/Local State" and opens one
# with --profile-directory; family "firefox" reads "<folder>/profiles.ini" and
# opens one with -P. The command is split into words and never run through a
# shell, so a line cannot smuggle shell syntax; only a leading "~/" is expanded
# in the folder. A browser whose command is not installed is left out, so one
# file can serve hosts that lack some of its browsers. With no file the built-in
# list is used; a file replaces it rather than adding to it, so it also sets the
# order and can drop a default.
LP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/link-picker/browsers"
LP_DEFAULTS='Firefox | firefox  | ~/.mozilla/firefox      | firefox
Chrome  | chromium | ~/.config/google-chrome | google-chrome'

B_NAME=(); B_FAMILY=(); B_DIR=(); B_CMD=()

lp_error() {
  yad --image=dialog-error --title="link-picker" --text="$1" --button=OK:0 \
    --geometry="$(geom 460 140)" 2>/dev/null || printf 'link-picker: %s\n' "$1" >&2
  exit 1
}

# flatpak_parse <words of a command...>: reads a flatpak command, which must
# have the form "flatpak run [option ...] <app id> [args ...]", every option
# one of flatpak run's own ("--" may end them), and an option that takes a
# value written "--option=value" with the value not empty. Sets FP_APP to the
# app id and FP_INFO to the arguments that make "flatpak info" ask about that
# same copy of the app: the installation (--user or -u, --system,
# --installation=), --arch= and the branch (--branch=, given to info as its
# second argument). Returns 0 for such a command, 1 for a command that is not
# flatpak, 2 for a flatpak command in any other form.
# The parser has to know which options take a value: "--runtime
# org.gnome.Platform org.x.Y" would otherwise read the runtime as the app id.
# Requiring "=" for those keeps the table the only thing it must know; an
# option missing from it, or a flag given "=value", is refused rather than
# guessed at. The tables are flatpak run's documented options (--help-all) as
# of flatpak 1.18, so a hidden deprecated one such as --no-desktop is refused;
# "-h", "--help" and "--help-all" are left out because they run no app.
FP_FLAGS=" user system devel log-session-bus log-system-bus log-a11y-bus
  no-a11y-bus a11y-bus no-session-bus session-bus no-documents-portal
  file-forwarding sandbox die-with-parent parent-expose-pids parent-share-pids
  clear-env verbose ostree-verbose "
FP_VALUED=" installation arch command cwd branch runtime runtime-version commit
  runtime-commit parent-pid instance-id-fd app-path app-fd usr-path usr-fd
  bind-fd ro-bind-fd share unshare share-if socket nosocket socket-if device
  nodevice device-if allow disallow allow-if filesystem nofilesystem env
  env-fd unset-env own-name talk-name no-talk-name system-own-name
  system-talk-name system-no-talk-name a11y-own-name add-policy remove-policy
  usb nousb usb-list usb-list-file persist "
# One space around every name, so that " name " matches whole names only.
FP_FLAGS=" $(printf '%s ' $FP_FLAGS)"
FP_VALUED=" $(printf '%s ' $FP_VALUED)"
# Short forms: each a flag, so they may be grouped ("-uv").
FP_SHORT=" u d p v "
FP_APP=""; FP_INFO=()
flatpak_parse() {
  local branch="" sel=() opt name value c i
  FP_APP=""; FP_INFO=()
  [ "$(basename "$1")" = flatpak ] || return 1
  [ "${2:-}" = run ] || return 2
  shift 2
  while [ $# -gt 0 ] && [ "${1:0:1}" = "-" ]; do
    opt=$1; shift
    case "$opt" in
      --) break ;;
      --*=*)
        name=${opt%%=*}; name=${name#--}; value=${opt#*=}
        [[ $FP_VALUED == *" $name "* ]] && [ -n "$value" ] || return 2
        case "$name" in
          installation|arch) sel+=("$opt") ;;
          branch) branch=$value ;;
        esac ;;
      --?*)
        name=${opt#--}
        [[ $FP_FLAGS == *" $name "* ]] || return 2
        case "$name" in user|system) sel+=("$opt") ;; esac ;;
      *)
        # A group of short flags; "-" alone is not an option.
        [ ${#opt} -gt 1 ] || return 2
        for ((i = 1; i < ${#opt}; i++)); do
          c=${opt:i:1}
          [[ $FP_SHORT == *" $c "* ]] || return 2
          # flatpak info knows no -u, so it gets the long form.
          if [ "$c" = u ]; then sel+=(--user); fi
        done ;;
    esac
  done
  [ $# -gt 0 ] || return 2
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z_][A-Za-z0-9_-]*){2,}$ ]] || return 2
  FP_APP=$1
  FP_INFO=("${sel[@]}" "$1")
  if [ -n "$branch" ]; then FP_INFO+=("$branch"); fi
  return 0
}

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

# load_browsers <source label> <text>: fills the B_* arrays. A malformed line is
# an error naming the line, never skipped: a typo would otherwise hide a browser.
load_browsers() {
  local src=$1 text=$2 n=0 line seps name family dir cmd words w rc
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=$(trim "$line")
    if [ -z "$line" ] || [ "${line:0:1}" = "#" ]; then continue; fi
    # Exactly four fields: counted by separators, since read drops an empty last one.
    seps=${line//[^|]/}
    name=""; family=""; dir=""; cmd=""
    IFS='|' read -r name family dir cmd <<<"$line" || true
    name=$(trim "$name"); family=$(trim "$family"); dir=$(trim "$dir"); cmd=$(trim "$cmd")
    if [ ${#seps} -ne 3 ] || [ -z "$name" ] || [ -z "$dir" ] || [ -z "$cmd" ]; then
      lp_error "$src, line $n: expected 'name | family | profile folder | command'."
    fi
    read -ra words <<<"$cmd"
    # A trailing comment would otherwise reach the browser as URLs.
    for w in "${words[@]}"; do
      [ "${w:0:1}" = "#" ] && lp_error "$src, line $n: comments go on a line of their own."
    done
    case "$family" in
      chromium|firefox) ;;
      *) lp_error "$src, line $n: unknown family '$family' (chromium or firefox)." ;;
    esac
    if [ "${dir:0:2}" = "~/" ]; then dir="$HOME/${dir:2}"; fi
    if flatpak_parse "${words[@]}"; then rc=0; else rc=$?; fi
    if [ $rc -eq 2 ]; then
      lp_error "$src, line $n: a flatpak command must read 'flatpak run [option ...] <app id>', with flatpak run's own options; options that take a value use the = form (--branch=stable)."
    fi
    command -v "${words[0]}" >/dev/null 2>&1 || continue
    # "flatpak run <app>" is installed only if that copy of the app is, not merely flatpak.
    if [ $rc -eq 0 ]; then
      flatpak info "${FP_INFO[@]}" >/dev/null 2>&1 || continue
    fi
    B_NAME+=("$name"); B_FAMILY+=("$family"); B_DIR+=("$dir"); B_CMD+=("$cmd")
  done <<<"$text"
}

if [ -e "$LP_CONFIG" ]; then
  [ -r "$LP_CONFIG" ] || lp_error "$LP_CONFIG is not readable."
  load_browsers "$LP_CONFIG" "$(cat "$LP_CONFIG")"
else
  load_browsers "built-in list" "$LP_DEFAULTS"
fi
[ ${#B_NAME[@]} -gt 0 ] || lp_error "None of the browsers listed is installed."

# --- profile pickers -------------------------------------------------------------
# Each prints the hidden key of the chosen row: "p:<profile>", "guest",
# "private" or "running".
pick_list() {  # <title> <height> <key> <label> ...
  local title=$1 h=$2
  shift 2
  yad --list \
    --title="$title" --text="Profile:" \
    --column="key" --column="Profile" \
    --hide-column=1 --print-column=1 \
    --separator="" --no-headers \
    --geometry="$(geom 380 "$h")" \
    "$@" 2>/dev/null
}

pick_chromium_profile() {  # <name> <folder>
  local e entries args=()
  mapfile -t entries < <(
    jq -r '.profile.info_cache | to_entries[] | "\(.key)|\(.value.name)"' \
      "$2/Local State" 2>/dev/null | sort -t'|' -k2,2
  )
  for e in "${entries[@]}"; do
    args+=("p:${e%%|*}" "${e#*|}")
  done
  pick_list "Open in $1" 500 "${args[@]}" guest "Guest"
}

# True when this Firefox-family browser already runs. -P cannot choose a profile
# then (the running instance takes the URL), so the list offers the running
# window instead. A flatpak is found by its application id, anything else by the
# command's own name.
firefox_running() {  # <words of the command...>
  if flatpak_parse "$@"; then
    flatpak ps --columns=application 2>/dev/null | grep -qxF -- "$FP_APP"
  else
    pgrep -x "$(basename "$1")" >/dev/null
  fi
}

pick_firefox_profile() {  # <name> <folder> <words of the command...>
  local title="Open in $1" ini="$2/profiles.ini" n names args=()
  shift 2
  if firefox_running "$@"; then
    pick_list "$title" 200 running "Running window" private "Private"
    return
  fi
  mapfile -t names < <(
    awk '/^\[Profile/{flag=1} flag && /^Name=/{sub(/^Name=/,""); print; flag=0}' \
      "$ini" 2>/dev/null | sort
  )
  for n in "${names[@]}"; do
    args+=("p:$n" "$n")
  done
  pick_list "$title" 320 "${args[@]}" private "Private"
}

# --- choose and open ---------------------------------------------------------------
rows=()
for i in "${!B_NAME[@]}"; do
  rows+=("$i" "${B_NAME[$i]}")
done
i=$(yad --list \
  --title="Open link" --text="Browser:" \
  --column="i" --column="Browser" \
  --hide-column=1 --print-column=1 \
  --separator="" --no-headers \
  --geometry="$(geom 280 $(( 170 + 30 * ${#B_NAME[@]} )))" \
  "${rows[@]}" 2>/dev/null) || exit 0
[[ $i =~ ^[0-9]+$ ]] && [ "$i" -lt ${#B_NAME[@]} ] || exit 0

# A later duplicate invocation may have supplied the complete URL.
if [ "$LP_DEDUPE" -eq 1 ] && [ -r "$LP_STATE/current" ]; then
  lp_own=""; lp_best=""
  read -r lp_own _ lp_best < "$LP_STATE/current" || true
  if [ "$lp_own" = "$$" ] && [ -n "$lp_best" ]; then
    URL_ARGS=("$lp_best")
  fi
fi

# open_private <words of the command...>: Firefox's --private-window takes one
# URL and opens any further ones in a normal window, so each URL gets a launch
# of its own. With one URL (or none) that is a plain exec. With several, the
# first launch may start the browser, so the rest wait (up to 10 s) until its
# process exists. That is not yet the moment it accepts remote calls: a launch
# made before then relies on Firefox's startup lock, which holds a second
# startup until the first instance is up and then hands the URL to it.
open_private() {
  local u n
  if [ ${#URL_ARGS[@]} -le 1 ]; then
    exec "$@" --private-window "${URL_ARGS[@]}"
  fi
  for u in "${URL_ARGS[@]}"; do
    if firefox_running "$@"; then
      "$@" --private-window "$u" >/dev/null 2>&1 || true
    else
      setsid -f "$@" --private-window "$u" >/dev/null 2>&1 </dev/null
      for n in $(seq 50); do
        firefox_running "$@" && break
        sleep 0.2
      done
    fi
  done
}

read -ra cmd <<<"${B_CMD[$i]}"
case "${B_FAMILY[$i]}" in
  chromium)
    key=$(pick_chromium_profile "${B_NAME[$i]}" "${B_DIR[$i]}") || exit 0
    case "$key" in
      guest) exec "${cmd[@]}" --guest "${URL_ARGS[@]}" ;;
      p:?*)  exec "${cmd[@]}" --profile-directory="${key#p:}" "${URL_ARGS[@]}" ;;
    esac
    ;;
  firefox)
    key=$(pick_firefox_profile "${B_NAME[$i]}" "${B_DIR[$i]}" "${cmd[@]}") || exit 0
    case "$key" in
      running) exec "${cmd[@]}" "${URL_ARGS[@]}" ;;
      private) open_private "${cmd[@]}" ;;
      p:?*)    exec "${cmd[@]}" -P "${key#p:}" "${URL_ARGS[@]}" ;;
    esac
    ;;
esac
exit 0
